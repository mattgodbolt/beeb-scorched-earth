\ ***************************************************************************
\ Computer players.
\
\ They aim the way the Atari 8-bit Scorch does: by firing invisible test
\ shots through the real ballistics (fly_quiet), so wind, walls and hills
\ in the way are all accounted for without any special cases. For each
\ angle they try, a binary search finds the power that lands nearest the
\ target; then each personality spoils its own aim by a different amount.
\ ***************************************************************************

HUMAN   = 0
MORON   = 1                 ; random
SHOOTER = 2                 ; one steep angle, rough power
TOSSER  = 3                 ; poor aim that improves with every shot
SPOILER = 4                 ; good aim, three angles
CYBORG  = 5                 ; better aim, and picks on the weakest tank
NTYPES  = 6


\ Power wobble by type, and the angles each one tries (degrees above the
\ horizontal, towards the target).
\ The 80 degree lob is what gets a shell over a mountain in the way:
\ without it two Spoilers either side of one could stalemate for ever.
\ The first three start at SHOOTER: humans and morons don't aim.
ASSERT SHOOTER = 2
\ The last column is a Lazy Boy's: a Spoiler that doesn't spoil.
LAZY = NTYPES
\ (ai_wobble, ai_first and ai_count are in lowdata.6502.)
.ai_angles  EQUB 70, 50, 45, 65, 80, 30

ZA_AUTO1 ai_target, ai_dir, ai_err
ZA_AUTO1 tank_angle_was     ; put back before the turret swings round
ZA_AUTO2 ai_power

\ Choose angle and power for computer player `cur`, then swing the turret
\ round to it where everyone can see.
.ai_turn
{
    ZA_AUTO1 type, n, k, tried, best_err, best_angle
    ZA_AUTO2 best_power
    \ Say whose turn it is before the thinking starts: a Spoiler can spend
    \ a couple of seconds on its test shots.
    JSR draw_status
    LDX cur : LDA tank_type,X : STA type
    \ Raise a shield if it has one, and use batteries when weak.
    JSR raise_shield
.shielded
    LDX cur : LDA tank_health,X : CMP #70 : BCS charged
    LDA #I_BATTERY : JSR inv_index : LDA inv,X : BEQ charged
    DEC inv,X
    LDX cur : LDA tank_health,X : ADC #10 : STA tank_health,X   ; (carry clear)
    BCC shielded                                ; (and still is)
.charged
    JSR choose_weapon
    JSR pick_target
    LDA type : CMP #MORON : BNE aimed_type
    \ A moron: anything from 30 to 150 degrees, 200-900 power.
.mangle
    JSR rand : CMP #121 : BCS mangle
    ADC #30 : STA best_angle
    JSR rand : CLC : ADC #100 : STA best_power  ; 2 * (rand + 100)
    LDA #0 : ROL A : STA best_power+1
    ASL best_power : ROL best_power+1
    JMP swing
\ A human's Lazy Boy comes in here (lazy_boy).
.lazy
    LDA #LAZY : STA type
    JSR pick_target
.aimed_type
    LDA #255 : STA best_err
    LDX type : LDA ai_count-SHOOTER,X : STA n
    LDA ai_first-SHOOTER,X : STA k
.angle
    LDX k : LDA ai_angles,X
    BIT ai_dir : BPL @+ : EOR #&FF : SEC : ADC #180 : .@  ; mirror for left
    STA tried : LDX cur : STA tank_angle,X
    JSR search_power
    LDA ai_err : CMP best_err : BEQ better : BCS worse
.better
    STA best_err
    LDA tried : STA best_angle
    LDA ai_power : STA best_power : LDA ai_power+1 : STA best_power+1
.worse
    INC k
    DEC n : BNE angle
    \ Spoil it: power +- wobble (a tosser's wobble halves each try).
    LDX type : LDA ai_wobble-SHOOTER,X : STA k
    CPX #TOSSER : BNE wobble
    LDX cur : LDY tank_tries,X : INC tank_tries,X
    CPY #4 : BCC halve : LDY #4                 ; (it never gets perfect)
.halve
    DEY : BMI wobble
    LSR k : BPL halve                           ; (always)
.wobble
    LDA k : BEQ swing
    LDX #0 : JSR rand
.mod
    CMP k : BCC @+ : SBC k : BCS mod : .@       ; (SBC left carry set)
    \ X:A = 2A - k - 1 (carry clear: A < 128), and the carry going into
    \ the ADC adds the 1 back: -k .. k
    ASL A : SBC k
    BCS @+ : DEX : SEC : .@                     ; X: its high byte
    ADC best_power : STA best_power
    TXA : ADC best_power+1 : STA best_power+1
    BPL swing
    LDA #0 : STA best_power : STA best_power+1  ; (not below nothing)
.swing
    \ Turn the turret a degree a frame, so people can see what is coming.
    LDX cur
    LDA best_power : STA tank_power_lo,X
    LDA best_power+1 : STA tank_power_hi,X
    JSR clamp_power
    LDA tank_angle_was : LDX cur : STA tank_angle,X
    JSR draw_status
.turn
    \ two degrees a frame
    LDX cur : LDA tank_angle,X : LSR A : BCC @+ : JSR wait_vsync : .@
    LDX cur : LDA tank_angle,X : CMP best_angle : BEQ there
    PHP : JSR erase_barrel : PLP
    LDX cur
    BCC @+ : DEC tank_angle,X : DEC tank_angle,X : .@
    INC tank_angle,X
    JSR draw_tank
    JSR draw_angle
    JMP turn
.there
    LDA #10 : JMP wait_frames
}

\ A Lazy Boy aims tank `cur` at the nearest enemy, perfectly.
lazy_boy = ai_turn.lazy

\ Pick a target: the nearest live enemy, or for a cyborg the weakest.
\ Sets ai_target and ai_dir (0 right, &FF left).
.pick_target
{
    ZA_AUTO1 best
    LDX cur : LDA tank_angle,X : STA tank_angle_was
    LDA #255 : STA best
    LDX #0
.loop
    CPX cur : BEQ next
    LDA tank_alive,X : BEQ next
    LDY cur : LDA tank_type,Y : CMP #CYBORG : BNE near
    LDA tank_health,X : BCS @+                  ; (always: CMP was equal)
.near
    JSR x_dist
.@  CMP best : BCS next
    STA best : STX ai_target
.next
    INX : CPX num_players : BNE loop
    \ the direction to it: x_dist's carry is clear for left
    LDX ai_target : LDY cur
    JSR x_dist
    LDA #0 : SBC #0 : STA ai_dir
    RTS
}

\ How far tank X is from tank Y -> A, with carry clear if X is to the left.
.x_dist
    LDA tank_x,X : SEC : SBC tank_x,Y
    BCS @+ : EOR #&FF : ADC #1 : .@             ; (which leaves carry clear)
    RTS

\ Binary-search the power, at the angle tank `cur` has, that lands the
\ shell nearest the target. Leaves ai_power and ai_err (pixels, 255 max).
.search_power
{
    ZA_AUTO 4, lo
    hi = lo + 2                 ; (so one index reaches either)
    ZA_AUTO1 iter
    LDA #LO(80) : STA lo : LDA #HI(80) : STA lo+1
    LDX cur : JSR max_power
    LDA num : STA hi : LDA num+1 : STA hi+1
    LDA #8 : STA iter
.step
    \ try the middle
    LDA lo : CLC : ADC hi : STA ai_power
    LDA lo+1 : ADC hi+1 : ROR A : STA ai_power+1 : ROR ai_power
    \ short: it becomes lo; long: it becomes hi
    JSR test_shot
    LDX #0 : BCS @+ : LDX #2 : .@
    LDA ai_power : STA lo,X : ZA_INDEXEDBY {0, 2}
    LDA ai_power+1 : STA lo+1,X : ZA_INDEXEDBY {0, 2}
    LDA ai_err : BEQ done                       ; spot on
    DEC iter : BNE step
.done
    RTS
}

\ Fire a test shot at ai_power. Carry set if it fell short. ai_err is how
\ far from the target it landed.
.test_shot
{
    ZA_AUTO1 prog
    ZA_AUTO1 walls_were
    LDX cur
    LDA ai_power : STA tank_power_lo,X
    LDA ai_power+1 : STA tank_power_hi,X
    LDA #0 : STA weapon
    \ The test shots ignore the walls: a shot is judged on how far it went.
    LDA wall_type : STA walls_were
    LDA #WALL_NONE : STA wall_type
    JSR launch
    JSR fly_quiet
    LDA walls_were : STA wall_type
    LDA hit_kind : CMP #HIT_TANK : BNE miss
    LDA hit_tank : CMP ai_target : BNE miss
    LDA #0 : BEQ long
.miss
    \ prog = how far the shell went past the target, away from the firer:
    \ short if negative, and err = |prog|
    \ (A = its high byte, which sets N and Z)
    LDX ai_target
    BIT ai_dir : BPL right
    LDA tank_x,X : SEC : SBC shot_x+2 : STA prog
    LDA #0 : SBC shot_x+3
    JMP judge                                   ; (JMP keeps the flags)
.right
    LDA shot_x+2 : SEC : SBC tank_x,X : STA prog
    LDA shot_x+3 : SBC #0
.judge
    BMI short
    BEQ near
    LDA #255 : BNE long                         ; 256 or more past it
.near
    LDA prog
.long
    STA ai_err
    CLC
    RTS
.short
    LDX #255
    CMP #&FF : BNE @+                           ; 256 or more short of it
    LDA #0 : SBC prog : TAX                     ; (CMP left carry set)
.@  STX ai_err
    SEC
    RTS
}

\ Choose the biggest gun in the inventory, most of the time.
.choose_weapon
{
    ZA_AUTO1 w, t
    LDX cur : LDA #0 : STA tank_weapon,X
    JSR rand : AND #3 : BEQ done                ; a quarter of the time: baby
    LDA #NWEAPONS-1 : STA w
.try
    \ (it only buys sandhogs of the burrowers)
    LIKES = (1 << SK_MISSILE) OR (1 << SK_MIRV) OR (1 << SK_ROLLER) OR (1 << SK_BURROW) OR (1 << SK_FUNKY)
    \ (A Leapfrog's kind holds its hops, so is past 15: shifted out, so
    \ never liked. SK_ITEM would read as bit 0, but no weapon has it.)
    LDY w : LDX item_kind,Y
    LDA #LO(LIKES) : STA t : LDA #HI(LIKES)
.bit
    LSR A : ROR t : DEX : BPL bit               ; carry = bit kind of LIKES
    BCC next
    LDA w : JSR inv_index : LDA inv,X : BEQ next
    LDX cur : LDA w : STA tank_weapon,X
    RTS
.next
    DEC w : BNE try
.done
    RTS
}
