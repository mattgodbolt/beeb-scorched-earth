\ ***************************************************************************
\ Sound, through the OS: OSWORD 8 defines the envelopes once, OSWORD 7
\ queues notes. Every sound is a four-byte entry in snd_tab (channel,
\ envelope, pitch, duration) expanded into the eight-byte OSWORD 7 block.
\ The block's high bytes are always zero: every sound uses an envelope, so
\ no amplitude is negative, and the channel word's hold/sync digits are 0.
\
\ Channels: 0 noise (fire, explosions), 1 fanfare, 2 click and death,
\ 3 the shell's whistle - so the whistle never cuts off anything else.
\ ***************************************************************************

\ The OSWORD 7 block. Only the even bytes are ever written.
.sblk   EQUW 0, 0, 0, 0

\ Channel words: +&10 flushes the channel first, so the new sound starts now
\ instead of queueing behind the last one.
E_FIRE    = 0
E_BOOM    = 4
E_CLICK   = 8
E_DIE     = 12
E_WHISTLE = 16
E_FANFARE = 20
.snd_tab
    EQUB &10, 1,   6,  1        ; fire: a burst of low noise
    EQUB &10, 1,   0,  0        ; boom: pitch and duration from snd_explode
    EQUB &12, 3, 200,  1        ; click
    EQUB &12, 2, 120, 30        ; die: a long falling tone
    EQUB &13, 4,   0,  2        ; whistle: pitch from flight_sound
    EQUB &11, 3, 101,  2        ; fanfare: C E G C
    EQUB &01, 3, 117,  2
    EQUB &01, 3, 129,  2
    EQUB &01, 3, 149,  8
.snd_tab_end


\ Explosion of radius A rows (5..36). Bigger is longer and, through the
\ noise channel's three white-noise rates, lower.
.snd_explode
{
    LDX #4
    CMP #10 : BCC @+ : INX
    CMP #20 : BCC @+ : INX
.@  STX sblk+4
    LSR A : ADC #2 : STA sblk+6 ; 4..20 twentieths of a second
    LDX #E_BOOM : BPL snd_play
}

\ Round won: four rising notes, queued on channel 1 to play out by
\ themselves.
.snd_fanfare
{
    LDA #E_FANFARE
.loop
    PHA : TAX : JSR snd_play
    PLA : CLC : ADC #4
    CMP #snd_tab_end - snd_tab : BNE loop
}
.snd_done
    RTS

\ Once a frame in flight: a whistle whose pitch follows the shell's height,
\ a semitone every 8 rows. A new note goes out when the pitch moves by a
\ semitone, or every fourth frame to keep the 1/10s note going; each one
\ flushes the last, so the queue never backs up behind a falling shell.
\ sblk+4 still holds the last pitch played (another sound may have changed
\ it, which only costs one early note).
.flight_sound
{
    LDA #250                    ; above the screen: the top of the range
    LDX shot_y+3 : BNE play
    LDA shot_y+2 : LSR A
    EOR #&FF : ADC #251         ; 250 - y/2, +1 from the LSR's carry: the
                                ; AND below swallows it
.play
    AND #&FC
    CMP sblk+4 : BNE new
    LDA vsyncs : AND #3 : BNE snd_done
    BEQ again                   ; (always) the same note, already in sblk
.new
    STA sblk+4
.again
}
\ The routines that just choose an entry fall into snd_play, each BITABS
\ swallowing the LDX of the next.
    LDX #E_WHISTLE : BITABS
.snd_fire
    LDX #E_FIRE : BITABS
.snd_click
    LDX #E_CLICK : BITABS
.snd_die
    LDX #E_DIE

\ Play snd_tab entry X. A zero in the entry leaves that field of sblk as
\ the caller set it, which is how pitch and duration are passed in.
.snd_play
{
    LDY #0
.copy
    LDA snd_tab,X : BEQ keep
    STA sblk,Y
.keep
    INX : INY : INY
    CPY #8 : BNE copy
    LDX #LO(sblk) : LDY #HI(sblk)
    LDA #7 : JMP osword
}
