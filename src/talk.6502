\ ***************************************************************************
\ Talking tanks. The lines are from the original's TALK1.CFG (said when
\ firing) and TALK2.CFG (said when dying), cut to fit.
\ Each is PACKED, so finding one means unpacking the ones before it.
\ ***************************************************************************

ATTACK_LINES = 9
DEATH_LINES  = 10
.talk
    PACKED "EAT MY SHORTS!"
    PACKED "YOU'RE TOAST!"
    PACKED "BANZAI!"
    PACKED "MAKE MY DAY."
    PACKED "KNOCK, KNOCK."
    PACKED "OPEN WIDE!"
    PACKED "TAKE THIS, SISSY!"
    PACKED "DON'T TAKE THIS PERSONALLY."
    PACKED "I WONDER WHAT THIS BUTTON DOES?"
    PACKED "UGH!"
    PACKED "AARGH!"
    PACKED "I'M MELTING!"
    PACKED "FAREWELL, CRUEL WORLD."
    PACKED "ANOTHER ONE BITES THE DUST."
    PACKED "I HATE IT WHEN THAT HAPPENS."
    PACKED "MOMMY? IS THAT YOU?"
    PACKED "THE FAT LADY SANG."
    PACKED "POW!"
    PACKED "ZONK!"

\ Tank `cur` says line A, in a bubble over its head, for a second or so.
.say
{
    ZA_AUTO1 len, x0, line
    STA line
    \ how wide is it?
    JSR seek
.count
    INX : JSR unpack : BNE count                ; (from X = &FF)
    TXA : ASL A : ASL A : STA len               ; pixels
    \ centred over the tank, kept on the screen
    LSR A : STA x0
    LDX cur : LDA tank_x,X : SEC : SBC x0 : BCS @+ : LDA #0 : .@
    AND #&FE : STA x0
    CLC : ADC len : BCS clip : CMP #SCREEN_W+1 : BCC @+
.clip
    LDA #SCREEN_W : SEC : SBC len : STA x0
.@  LDA x0 : STA text_x : STA rect_x0
    CLC : ADC len : SBC #0 : STA rect_x1
    LDA tank_y,X : SEC : SBC #20
    CMP #TOP : BCS @+ : LDA #TOP : .@
    STA text_y : STA bg_y0
    CLC : ADC #5 : STA bg_y1
    LDA tank_colour,X : JSR ink
    JSR seek : JSR print_packed
    LDA #75 : JSR wait_frames
    JSR repaint
    JMP draw_tanks

.seek
    LDA line : LDX #LO(talk) : LDY #HI(talk) : JMP packed_nth
}
