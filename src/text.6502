\ ***************************************************************************
\ Text: a 3x5 font in 4x6 cells, so MODE 2 gets 40 columns.
\ Glyphs are drawn byte-aligned: a cell is exactly two screen bytes wide.
\ ***************************************************************************

\ (The font and cbytes, colour bytes for logical colours 0-15, are in
\ lowdata.6502.)

ZA_AUTO1 text_x, text_y     ; pixel position of the next character (x even)

\ Choose the text colour: A = a logical colour. The paper is always
\ black, so a glyph's pixels are just ink_byte under a mask.
ZA_AUTO1 ink_byte
.white
    LDA #C_WHITE
.ink
    TAX : LDA cbytes,X : STA ink_byte
    RTS

\ Draw character A at (text_x, text_y) and move text_x on a cell. Returns
\ A = text_x (menu.6502's "JSR draw_char : JSR draw_char" relies on that
\ being >= 96, past Z, so the second call draws a space), never zero, and
\ with carry clear: menu.6502 relies on both. Preserves Y, which the two
\ loops below that print with it index by.
.draw_char
{
    ZA_AUTO2 bits
    ZA_AUTO1 row, y, ysave
    STY ysave
    \ Nothing passes a control code; anything past the font is a space.
    CMP #32 + (font_end - font) DIV 2 : BCC @+ : LDA #32 : .@
    ASL A : TAX
    LDA font-64,X : STA bits                    ; (the font starts at 32)
    LDA font-63,X : STA bits+1
    LDA #6 : STA row
    LDA text_y : STA y
.rowloop
    LDY y : LDX text_x : JSR pixaddr
    \ Next three bits: two for the first byte, one for the second.
    LDA #0
    ASL bits : ROL bits+1 : ROL A
    ASL bits : ROL bits+1 : ROL A
    TAX : LDA pixmasks,X : AND ink_byte
    LDY #0 : STA (scr),Y
    ASL bits : ROL bits+1
    LDA #0 : BCC @+ : LDA #LEFTPIX : .@
    AND ink_byte
    LDY #8 : STA (scr),Y
    INC y
    DEC row : BNE rowloop
    LDY ysave
    \ (carry is clear: the last bits shifted out of bits were padding)
    LDA text_x : ADC #4 : STA text_x
    RTS
}

ZA_AUTO2 str_ptr

\ Print the zero-terminated string at (A = lo, X = hi).
.print_string
    STA str_ptr : STX str_ptr+1
    LDY #0
\ Print from (str_ptr),Y to the terminator; returns Y = its index.
.print_from
{
.next
    LDA (str_ptr),Y : BEQ done
    JSR draw_char
    INY : BNE next
.done
    RTS
}

ZA_AUTO 3, num

\ Print an 8-bit number in A, right-aligned in X characters.
.print_byte
    STA num
    LDA #0 : STA num+1 : STA num+2
    TXA
    \ fall through

\ Print num (24-bit) in decimal, right-aligned in A characters, padded
\ with spaces (A = 1..8).
.print_num
{
    ZA_AUTO1 width, started, lo, mid
    STA width
    LDA #0 : STA started
    LDY #7                      ; power-of-ten index, 10^7 .. 10^0
.place
    LDX #0                      ; the digit
.sub
    LDA num : SEC : SBC pow_lo,Y : STA lo
    LDA num+1 : SBC pow_mid,Y : STA mid
    LDA num+2 : SBC pow_hi,Y : BCC enough
    STA num+2 : LDA mid : STA num+1 : LDA lo : STA num
    INX : BCS sub               ; (always: carry is still set)
.enough
    TXA : ORA started : STA started
    BNE show
    TYA : BEQ show              ; the units digit always shows
    CPY width : BCS skip        ; leading zeroes outside the field: nothing
    LDA #32 : BNE out           ; inside it: a space
.show
    TXA : ORA #48
.out
    JSR draw_char
.skip
    DEY : BPL place
    RTS
    \ (pow_lo/mid/hi are in lowdata.6502.)
}

\ (The font is in lowdata.6502.)
