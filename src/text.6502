\ ***************************************************************************
\ Text: a 3x5 font in 4x6 cells, so MODE 2 gets 40 columns.
\ Glyphs are drawn byte-aligned: a cell is exactly two screen bytes wide.
\ ***************************************************************************

\ (The font and cbytes, colour bytes for logical colours 0-15, are in
\ lowdata.6502.)

ZA_AUTO1 text_x, text_y     ; pixel position of the next character (x even)

\ Choose the text colour: A = a logical colour. The paper is always
\ black, so a glyph's pixels are just ink_byte under a mask.
ZA_AUTO1 ink_byte
.white
    LDA #C_WHITE
.ink
    TAX : LDA cbytes,X : STA ink_byte
    RTS

\ Draw character A at (text_x, text_y) and move text_x on a cell: A is
\ ASCII, except as the font says. Returns A = text_x (menu.6502's
\ "JSR draw_char : JSR draw_char" relies on that being outside the font,
\ so the second call draws a space), never zero, and with carry clear:
\ menu.6502 relies on both. Preserves Y, which the two loops below that
\ print with it index by.
.draw_char
{
    ZA_AUTO2 bits
    ZA_AUTO1 row, y, ysave
    STY ysave
    \ Anything outside the font, space included, is a space.
    SEC : SBC #FONT_LO : CMP #FONT_HI - FONT_LO : BCC @+
    LDA #FONT_BLANK - FONT_LO : .@
    ASL A : TAX
    LDA font,X : STA bits
    LDA font+1,X : STA bits+1
    LDA #6 : STA row
    LDA text_y : STA y
.rowloop
    LDY y : LDX text_x : JSR pixaddr
    \ Next three bits: two for the first byte, one for the second.
    LDA #0
    ASL bits : ROL bits+1 : ROL A
    ASL bits : ROL bits+1 : ROL A
    TAX : LDA pixmasks,X : AND ink_byte
    LDY #0 : STA (scr),Y
    ASL bits : ROL bits+1
    LDA #0 : BCC @+ : LDA #LEFTPIX : .@
    AND ink_byte
    LDY #8 : STA (scr),Y
    INC y
    DEC row : BNE rowloop
    LDY ysave
    \ (carry is clear: the last bits shifted out of bits were padding)
    LDA text_x : ADC #4 : STA text_x
    RTS
}

\ Packed text, five bits a character, first bit highest: code c is font
\ character c + 64 - letters, then 27-29 for . ! ' and 30 for a space
\ (94, past the font). 31 ends the string, which is padded to a whole byte.
\ Code 0 escapes: the next five bits are font character 32-63, for digits
\ and the rarer punctuation. menu.6502's unpack reads it. (Defined here,
\ ahead of every file that uses it.)
\ T5 is the codes for each of ASCII 32-90; 99 marks one the font lacks.
NO = 99
T5_PUNCT = {{30}, {28}, {NO}, {NO}, {0, 26}, {NO}, {NO}, {29}, {NO}, {NO}, {NO}, {0, 14}, {0, 27}, {0, 29}, {27}, {0, 15}}
T5 = CONCAT(T5_PUNCT, ZIP(REPEATED(10, 0), 16..25), {{NO}, {NO}, {0, 28}, {NO}, {0, 30}, {0, 31}, {NO}}, ZIP(1..26))
ASSERT LEN(T5) = 90 - 32 + 1
FUNCTION codes5(s) = CONCAT(FLATTEN(T5[CODES(s) - 32]), 31, 0, 0)
MACRO PACKED text
    c5 = codes5(text)
    ASSERT MAX(c5) < 32                         ; (else the font lacks one)
    FOR k = 0..<((LEN(c5) - 2) * 5 + 7) DIV 8
        EQUB ((c5[k * 8 DIV 5] * 1024 + c5[k * 8 DIV 5 + 1] * 32 + c5[k * 8 DIV 5 + 2]) >> (7 - k * 8 MOD 5)) AND 255
    NEXT
ENDMACRO

ZA_AUTO 3, num

\ Print an 8-bit number in A, right-aligned in X characters.
.print_byte
    STA num
    LDA #0 : STA num+1 : STA num+2
    TXA
    \ fall through

\ Print num (24-bit) in decimal, right-aligned in A characters, padded
\ with spaces (A = 1..8).
.print_num
{
    ZA_AUTO1 width, started, lo, mid
    STA width
    LDA #0 : STA started
    LDY #7                      ; power-of-ten index, 10^7 .. 10^0
.place
    LDX #0                      ; the digit
.sub
    LDA num : SEC : SBC pow_lo,Y : STA lo
    LDA num+1 : SBC pow_mid,Y : STA mid
    LDA num+2 : SBC pow_hi,Y : BCC enough
    STA num+2 : LDA mid : STA num+1 : LDA lo : STA num
    INX : BCS sub               ; (always: carry is still set)
.enough
    TXA : ORA started : STA started
    BNE show
    TYA : BEQ show              ; the units digit always shows
    CPY width : BCS skip        ; leading zeroes outside the field: nothing
    LDA #32 : BNE out           ; inside it: a space
.show
    TXA : ORA #48
.out
    JSR draw_char
.skip
    DEY : BPL place
    RTS
    \ (pow_lo/mid/hi are in lowdata.6502.)
}

\ (The font is in lowdata.6502.)
