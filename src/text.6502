\ ***************************************************************************
\ Text: a 3x5 font in 4x6 cells, so MODE 2 gets 40 columns.
\ Glyphs are drawn byte-aligned: a cell is exactly two screen bytes wide.
\ ***************************************************************************

\ A glyph is five rows of three pixels packed into a word, top row in the
\ top bits: rows land at bits 15-13, 12-10, 9-7, 6-4 and 3-1.
FUNCTION rowbits(s) = SUM((CODES(s) == 35) * {4, 2, 1})
FUNCTION glyph(a, b, c, d, e) = (rowbits(a) << 13) + (rowbits(b) << 10) + (rowbits(c) << 7) + (rowbits(d) << 4) + (rowbits(e) << 1)
MACRO GLYPH a, b, c, d, e
    EQUW glyph(a, b, c, d, e)
ENDMACRO

\ Colour bytes for logical colours 0-15, both pixels.
.cbytes
    EQUB cbyte(0..15)

ZA_AUTO1 text_x, text_y     ; pixel position of the next character (x even)

\ Choose text colours: A = foreground, X = background (logical colours).
\ Builds the four two-pixel patterns a glyph row is made of. Every caller
\ so far wants black paper, hence the shorter entry points.
.white
    LDA #C_WHITE
.ink
    LDX #C_BLACK
.set_colours
{
    ZA_AUTO1 diff
    \ pattern = paper EOR ((ink EOR paper) AND mask): ink under the mask
    TAY : LDA cbytes,Y : EOR cbytes,X : STA diff
    LDY #3
.loop
    LDA diff : AND masks,Y : EOR cbytes,X : STA pattern,Y
    DEY : BPL loop
    RTS
.masks EQUB 0, RIGHTPIX, LEFTPIX, &FF       ; .. .# #. ##
}
.pattern EQUB 0, 0, 0, 0

\ Draw character A at (text_x, text_y) and move text_x on a cell. Returns
\ A = text_x (menu.6502's "JSR draw_char : JSR draw_char" relies on that
\ being >= 96, so the second call draws a space).
.draw_char
{
    ZA_AUTO2 bits
    ZA_AUTO1 row, y
    SEC : SBC #32 : CMP #64 : BCC @+ : LDA #0 : .@   ; anything else is a space
    ASL A : TAX
    LDA font,X : STA bits
    LDA font+1,X : STA bits+1
    LDA #6 : STA row
    LDA text_y : STA y
.rowloop
    LDY y : LDX text_x : JSR pixaddr
    \ Next three bits: two for the first byte, one for the second.
    LDA #0
    ASL bits : ROL bits+1 : ROL A
    ASL bits : ROL bits+1 : ROL A
    TAX : LDA pattern,X
    LDY #0 : STA (scr),Y
    LDA #0
    ASL bits : ROL bits+1 : ROL A
    ASL A : TAX : LDA pattern,X
    LDY #8 : STA (scr),Y
    INC y
    DEC row : BNE rowloop
    LDA text_x : CLC : ADC #4 : STA text_x
    RTS
}

\ Print the zero-terminated string that follows the JSR.
ZA_AUTO2 str_ptr
.print_inline
{
    PLA : STA str_ptr : PLA : STA str_ptr+1
    LDY #1                                      ; the JSR pushed its last byte
    JSR print_from
    \ Return to the terminator's address, + 1 by the RTS.
    TYA : CLC : ADC str_ptr : TAX
    LDA str_ptr+1 : ADC #0 : PHA
    TXA : PHA
    RTS
}

\ Print the zero-terminated string at (A = lo, X = hi).
.print_string
    STA str_ptr : STX str_ptr+1
    LDY #0
\ Print from (str_ptr),Y to the terminator; returns Y = its index.
.print_from
{
    ZA_AUTO1 y
.next
    LDA (str_ptr),Y : BEQ done
    STY y : JSR draw_char : LDY y
    INY : BNE next
.done
    RTS
}

ZA_AUTO 3, num

\ Print an 8-bit number in A, right-aligned in X characters.
.print_byte
    STA num
    LDA #0 : STA num+1 : STA num+2
    TXA
    \ fall through

\ Print num (24-bit) in decimal, right-aligned in A characters, padded
\ with spaces (A = 1..8).
.print_num
{
    ZA_AUTO1 width, digit, started, mid, xsave
    STA width
    LDA #0 : STA started
    LDX #7                      ; power-of-ten index, 10^7 .. 10^0
.place
    LDA #0 : STA digit
.sub
    LDA num : SEC : SBC pow_lo,X : TAY
    LDA num+1 : SBC pow_mid,X : STA mid
    LDA num+2 : SBC pow_hi,X : BCC enough
    STA num+2 : LDA mid : STA num+1 : STY num
    INC digit : BCS sub         ; (always: carry is still set)
.enough
    LDA digit : ORA started : STA started
    BNE show
    TXA : BEQ show              ; the units digit always shows
    CPX width : BCS skip        ; leading zeroes outside the field: nothing
    LDA #32 : BNE out           ; inside it: a space
.show
    LDA digit : ORA #48
.out
    STX xsave : JSR draw_char : LDX xsave
.skip
    DEX : BPL place
    RTS
.pow_lo  EQUB LO({1, 10, 100, 1000, 10000, 100000, 1000000, 10000000})
.pow_mid EQUB HI({1, 10, 100, 1000, 10000, 100000, 1000000, 10000000})
.pow_hi  EQUB ({1, 10, 100, 1000, 10000, 100000, 1000000, 10000000} >> 16) AND 255
}

\ Glyphs for ASCII 32-95.
.font
    GLYPH "...", "...", "...", "...", "..."     ; space
    GLYPH ".#.", ".#.", ".#.", "...", ".#."     ; !
    GLYPH "#.#", "#.#", "...", "...", "..."     ; "
    GLYPH "#.#", "###", "#.#", "###", "#.#"     ; #
    GLYPH ".##", "##.", ".#.", ".##", "##."     ; $
    GLYPH "#.#", "..#", ".#.", "#..", "#.#"     ; %
    GLYPH ".#.", "#.#", ".#.", "#.#", ".##"     ; &
    GLYPH ".#.", ".#.", "...", "...", "..."     ; '
    GLYPH "..#", ".#.", ".#.", ".#.", "..#"     ; (
    GLYPH "#..", ".#.", ".#.", ".#.", "#.."     ; )
    GLYPH "...", "#.#", ".#.", "#.#", "..."     ; *
    GLYPH "...", ".#.", "###", ".#.", "..."     ; +
    GLYPH "...", "...", "...", ".#.", "#.."     ; ,
    GLYPH "...", "...", "###", "...", "..."     ; -
    GLYPH "...", "...", "...", "...", ".#."     ; .
    GLYPH "..#", "..#", ".#.", "#..", "#.."     ; /
    GLYPH "###", "#.#", "#.#", "#.#", "###"     ; 0
    GLYPH ".#.", "##.", ".#.", ".#.", "###"     ; 1
    GLYPH "###", "..#", "###", "#..", "###"     ; 2
    GLYPH "###", "..#", ".##", "..#", "###"     ; 3
    GLYPH "#.#", "#.#", "###", "..#", "..#"     ; 4
    GLYPH "###", "#..", "###", "..#", "###"     ; 5
    GLYPH "###", "#..", "###", "#.#", "###"     ; 6
    GLYPH "###", "..#", "..#", ".#.", ".#."     ; 7
    GLYPH "###", "#.#", "###", "#.#", "###"     ; 8
    GLYPH "###", "#.#", "###", "..#", "###"     ; 9
    GLYPH "...", ".#.", "...", ".#.", "..."     ; :
    GLYPH "...", ".#.", "...", ".#.", "#.."     ; ;
    GLYPH "..#", ".#.", "#..", ".#.", "..#"     ; <
    GLYPH "...", "###", "...", "###", "..."     ; =
    GLYPH "#..", ".#.", "..#", ".#.", "#.."     ; >
    GLYPH "###", "..#", ".##", "...", ".#."     ; ?
    GLYPH ".#.", "#.#", "###", "#..", ".##"     ; @
    GLYPH ".#.", "#.#", "###", "#.#", "#.#"     ; A
    GLYPH "##.", "#.#", "##.", "#.#", "##."     ; B
    GLYPH ".##", "#..", "#..", "#..", ".##"     ; C
    GLYPH "##.", "#.#", "#.#", "#.#", "##."     ; D
    GLYPH "###", "#..", "##.", "#..", "###"     ; E
    GLYPH "###", "#..", "##.", "#..", "#.."     ; F
    GLYPH ".##", "#..", "#.#", "#.#", ".##"     ; G
    GLYPH "#.#", "#.#", "###", "#.#", "#.#"     ; H
    GLYPH "###", ".#.", ".#.", ".#.", "###"     ; I
    GLYPH "..#", "..#", "..#", "#.#", ".#."     ; J
    GLYPH "#.#", "#.#", "##.", "#.#", "#.#"     ; K
    GLYPH "#..", "#..", "#..", "#..", "###"     ; L
    GLYPH "#.#", "###", "###", "#.#", "#.#"     ; M
    GLYPH "##.", "#.#", "#.#", "#.#", "#.#"     ; N
    GLYPH ".#.", "#.#", "#.#", "#.#", ".#."     ; O
    GLYPH "##.", "#.#", "##.", "#..", "#.."     ; P
    GLYPH ".#.", "#.#", "#.#", "##.", ".##"     ; Q
    GLYPH "##.", "#.#", "##.", "#.#", "#.#"     ; R
    GLYPH ".##", "#..", ".#.", "..#", "##."     ; S
    GLYPH "###", ".#.", ".#.", ".#.", ".#."     ; T
    GLYPH "#.#", "#.#", "#.#", "#.#", "###"     ; U
    GLYPH "#.#", "#.#", "#.#", "#.#", ".#."     ; V
    GLYPH "#.#", "#.#", "###", "###", "#.#"     ; W
    GLYPH "#.#", "#.#", ".#.", "#.#", "#.#"     ; X
    GLYPH "#.#", "#.#", ".#.", ".#.", ".#."     ; Y
    GLYPH "###", "..#", ".#.", "#..", "###"     ; Z
    GLYPH "##.", "#..", "#..", "#..", "##."     ; [
    GLYPH "#..", "#..", ".#.", "..#", "..#"     ; \
    GLYPH ".##", "..#", "..#", "..#", ".##"     ; ]
    GLYPH ".#.", "#.#", "...", "...", "..."     ; ^
    GLYPH "...", "...", "...", "...", "###"     ; _
