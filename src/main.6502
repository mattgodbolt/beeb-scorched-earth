\ ***************************************************************************
\ SCORCHED EARTH for the BBC Micro - build file
\
\ !BOOT *RUNs SCORCH, which loads at &1900, selects *TAPE so the DFS lets go
\ of its workspace, copies the game down to &0E00 and runs it.
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "memory.6502"

\ MODE 2 is selected here, by BASIC, before the game is loaded: the game
\ reaches past &3000 once it is copied down, so a MODE change after that
\ would wipe the top of it. The palette is blacked out so the game file
\ passing through screen memory on its way in is not seen.
\ The build stamp comes from the Makefile (-D BUILD="date-sha").
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| SCORCHED EARTH ", build_stamp, 13
    EQUS "MODE 2", 13
    EQUS "FOR I%=0 TO 15:VDU 19,I%,0;0;:NEXT", 13
    EQUS "*RUN SCORCH", 13
ENDSECTION

SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = "SCORCH"
.payload
    SECTION Code, org = &0E00, guard = screen
    ZA_POOL &00..zp_fixed-1     ; zp_fixed..&8F: busy arrays (memory.6502)

    \ No entry point here: boot.6502 jumps straight to main, so the
    \ allocator follows one flow from boot into the game.
    .start

    INCLUDE "system.6502"
    INCLUDE "gfx.6502"
    INCLUDE "text.6502"
    INCLUDE "terrain.6502"
    INCLUDE "tank.6502"
    INCLUDE "shot.6502"
    INCLUDE "explode.6502"
    INCLUDE "weapons.6502"
    INCLUDE "napalm.6502"
    INCLUDE "special.6502"
    INCLUDE "ai.6502"
    INCLUDE "menu.6502"
    INCLUDE "talk.6502"
    INCLUDE "sound.6502"
    INCLUDE "game.6502"

    .code_end
    PRINT "code &", ~start, "-&", ~code_end, " (", screen - code_end, " bytes free)"
    ENDSECTION

    \ The start-up code, carried here and run from skyrow/dirtrow (see
    \ boot.6502), so it never takes up code space.
    .boot_payload
    SECTION Startup, org = skyrow, guard = skyrow + 512
    INCLUDE "boot.6502"
    ENDSECTION

    INCLUDE "lowdata.6502"

\ Runs in screen memory, after the payload. Nothing in here may be needed
\ afterwards.
.loader
    LDX #LO(tape) : LDY #HI(tape) : JSR oscli
    LDX #HI(code_end - start + &FF)
    LDY #0
.copy
    LDA payload,Y : STA start,Y
    INY : BNE copy
    INC copy+2 : INC copy+5
    DEX : BNE copy
    \ Two whole pages: the Startup guard keeps boot.6502 inside them.
.copy_boot
    LDA boot_payload,Y : STA boot,Y
    LDA boot_payload+256,Y : STA boot+256,Y
    INY : BNE copy_boot
    JMP boot
.tape
    EQUS "TAPE", 13
ENDSECTION
