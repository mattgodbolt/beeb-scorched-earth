\ ***************************************************************************
\ System: screen mode, vsync counting, keyboard.
\ ***************************************************************************

\ The OS has already saved A at &FC; X and Y must be left alone. The
\ System VIA's CA1 flag is vsync.
.our_irq
{
    ZA_INTERRUPT
    LDA sysvia_ifr : AND #2 : BEQ chain
    INC vsyncs
.chain
    JMP (old_irq)
    ZA_CANJUMP &E000           ; the OS handler
}
.old_irq  EQUW 0
.vsyncs   EQUB 0

\ Wait for the next vsync.
.wait_vsync
{
    BIT ff : BMI done                           ; fast-forwarding
    LDA vsyncs
.wait
    CMP vsyncs : BEQ wait
.done
    RTS
}
.ff EQUB 0                  ; bit 7 set: don't wait for anything

\ Wait A frames.
.wait_frames
{
    ZA_AUTO1 n
    STA n
.loop
    JSR wait_vsync
    DEC n : BNE loop
    RTS
}

\ Is a key down? X = internal key number EOR &FF (i.e. the negative INKEY
\ value). Returns with Z clear (BNE) if it is.
.key_down
{
    LDA #129 : LDY #&FF : JSR osbyte
    CPX #0
    RTS
}

\ Negative INKEY numbers for the keys we use.
K_SPACE  = &9D
K_RETURN = &B6
K_LEFT   = &E6
K_RIGHT  = &86
K_UP     = &C6
K_DOWN   = &D6
K_SHIFT  = &FF
K_TAB    = &9F
K_ESCAPE = &8F
K_B      = &9B
K_S      = &AE
