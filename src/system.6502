\ ***************************************************************************
\ System: screen mode, vsync counting, keyboard.
\ ***************************************************************************

\ In zero page, for the shorter instructions. ZA_INTERRUPT gives the bytes
\ the handler shares with the rest of the program addresses of their own.
ZA_AUTO2 old_irq            ; the OS's IRQ1V handler (boot saves it)
ZA_AUTO1 ff                ; bit 7 set: don't wait for anything
\ Frames since start-up. The game seeds from it, so init_system zeroes it
\ before hooking the IRQ: zero page arrives holding the DFS's leftovers.
ZA_AUTO1 vsyncs

\ The OS has already saved A at &FC; X and Y must be left alone. The
\ System VIA's CA1 flag is vsync.
.our_irq
{
    ZA_INTERRUPT
    LDA sysvia_ifr : AND #2 : BEQ chain
    INC vsyncs
.chain
    JMP (old_irq)
    ZA_CANJUMP &E000           ; the OS handler
}

\ Wait for the next vsync. (Nothing waits before a round has set ff.)
.wait_vsync
{
    BIT ff : BMI done                           ; fast-forwarding
    LDA vsyncs
.wait
    CMP vsyncs : BEQ wait
.done
    RTS
}

\ Wait A frames. Returns X = 0.
.wait_frames
{
    TAX
.loop
    JSR wait_vsync
    DEX : BNE loop
    RTS
}

\ Is a key down? X = internal key number EOR &FF (i.e. the negative INKEY
\ value). Returns with Z clear (BNE) if it is: OSBYTE 129 returns X = &FF
\ for a key that is down and 0 for one that isn't.
.key_down
{
    LDA #129 : LDY #&FF : JSR osbyte
    TXA
    RTS
}

\ Negative INKEY numbers for the keys we use.
K_SPACE  = &9D
K_RETURN = &B6
K_LEFT   = &E6
K_RIGHT  = &86
K_UP     = &C6
K_DOWN   = &D6
K_SHIFT  = &FF
K_TAB    = &9F
K_ESCAPE = &8F
K_B      = &9B
K_S      = &AE
K_R      = &CC
K_L      = &A9
K_Z      = &9E
K_X      = &BD
