\ ***************************************************************************
\ Graphics primitives: tables, pixels, spans, discs.
\ Nothing here goes through the OS.
\ ***************************************************************************

\ Point scr at the screen byte holding pixel (X, Y). Preserves X and Y.
\ Returns A = scr+1 and carry clear. The column's offset, (x >> 1) * 8, is
\ worked out rather than looked up: its two tables would take 320 bytes of
\ the holes below &0E00, which hold the inventory instead.
ZA_AUTO2 scr
.pixaddr
    LDA #0 : STA scr+1
    TXA : ASL A : ROL scr+1 : ASL A : ROL scr+1 ; (each ROL clears carry)
    AND #&F8 : ADC rowlo,Y : STA scr
    LDA rowhi,Y : ADC scr+1 : STA scr+1
    RTS

\ Put the background back at one pixel. X = x, Y = y. The background is
\ the model's: dirt at or below the ground line, sky above it.
.unplot
    TYA : CMP ground,X                          ; carry set: dirt
    LDA skyrow,Y : BCC plot
    LDA dirtrow,Y
    \ fall through

\ Plot one pixel. X = x, Y = y, A = colour byte (both pixels; only the half
\ that belongs to x is used). Preserves X and Y.
.plot
{
    ZA_AUTO1 col, ysave
    STA col : STY ysave
    JSR pixaddr
    LDY #0
    TXA : LSR A                                 ; carry set: the right pixel
    \ old EOR ((old EOR col) AND mask) takes col's bits under the mask only
    LDA (scr),Y : EOR col
    BCS right
    AND #LEFTPIX
    BITABS
.right
    AND #RIGHTPIX
    EOR (scr),Y : STA (scr),Y
    LDY ysave
    RTS
}

\ Fill a horizontal run of pixels. Y = row, span_x0..span_x1 inclusive
\ (already clipped to the screen), A = colour byte. Preserves Y.
ZA_AUTO1 span_x0, span_x1
.hspan
{
    ZA_AUTO1 fill, row
    STA fill : STY row
    LDX span_x0
    TXA : LSR A : BCC even
    \ Odd start: the first byte gets its right pixel only.
    LDA fill : JSR plot
    INX
.even
    JSR pixaddr
    LDY #0
.whole
    CPX span_x1 : BCS tail                      ; fewer than two pixels left
    LDA fill : STA (scr),Y
    TYA : ADC #8 : TAY                          ; (the CPX left carry clear)
    BCC @+ : INC scr+1 : .@
    INX : INX : BNE whole                       ; (always: X <= 160)
.tail
    LDA fill : LDY row
    CPX span_x1 : BEQ plot                      ; one left: a left pixel
    RTS                                         ; none
}

\ Draw the whole playfield from the model. From row 0, not TOP: the
\ status bar's model is black sky, so this clears that too. FLOOR is past
\ the right edge, which repaint clips.
.draw_terrain
    LDA #0 : LDX #FLOOR
\ Repaint rows A to X, the whole width. (A whole screen's worth takes
\ most of a second.)
.repaint_rows
    STA bg_y0 : STX bg_y1
    LDA #0 : STA rect_x0
    LDA #FLOOR : STA rect_x1
    \ fall through

\ Repaint a rectangle from the model: pixels rect_x0..rect_x1 (clipped
\ here), rows bg_y0..bg_y1 inclusive, a byte column (two pixels) at a
\ time.
ZA_AUTO1 bg_y0, bg_y1
ZA_AUTO1 rect_x0, rect_x1
.repaint
{
    ZA_AUTO1 c, cend, gl, gr
    ZA_AUTO2 off
    LDA rect_x1 : CMP #SCREEN_W : BCC @+ : LDA #SCREEN_W-1 : .@
    LSR A : STA cend
    LDA rect_x0 : LSR A : STA c                 ; (callers clip x0 at 0)
.col
    \ The column's offset into a character row, c * 8, once per column:
    \ adding it inline below is faster than calling pixaddr every row.
    LDY #0 : STY off+1
    LDA c : ASL A : TAX                         ; the column's left pixel
    ASL A : ROL off+1 : ASL A : ROL off+1 : STA off
    LDA ground,X : STA gl
    LDA ground+1,X : STA gr
    LDY bg_y0
.row
    LDA rowlo,Y : CLC : ADC off : STA scr
    LDA rowhi,Y : ADC off+1 : STA scr+1
    \ Which of the two pixels are dirt picks the pixmasks entry; then
    \ sky EOR ((sky EOR dirt) AND mask) is dirt under the mask.
    LDA #0 : CPY gl : ROL A : CPY gr : ROL A : TAX
    LDA skyrow,Y : EOR dirtrow,Y : AND pixmasks,X : EOR skyrow,Y
    LDX #0 : STA (scr,X)
    ZA_INDEXEDBY 0
    CPY bg_y1 : BEQ next
    INY : BNE row                               ; (always: rows end at FLOOR)
.next
    LDA c : INC c : CMP cend : BNE col
    RTS
}

\ (pixmasks is in lowdata.6502.)

\ ---------------------------------------------------------------------------
\ Discs. Everything round in the game is built from `profile`, the
\ half-width (in pixels) of each row of a disc of radius disc_r rows, and
\ `colspan`, the half-height (in rows) of each column. Pixels are about
\ twice as wide as they are tall, so a disc is half as wide in pixels as it
\ is tall in rows, and looks round.

ZA_AUTO1 disc_r, disc_cx, disc_cy

\ Build profile[0..disc_r] and colspan[0..profile[0]] for radius disc_r.
.make_profile
{
    ZA_AUTO1 x, dy, e
    \ The midpoint circle: row dy reaches out to the largest x with
    \ x^2 + dy^2 <= r^2 + r. e tracks r^2 + r - x^2 - dy^2, which stays
    \ within -127..126, so its sign bit says whether x fits.
    LDA disc_r : STA x : STA e                  ; x = r, dy = 0: e = r, so x fits
    LDA #0 : STA dy
.fits
    \ profile[dy] = x / 2 to the nearest, halves rounding down
    LDA x : ASL A : ADC #1 : LSR A : LSR A
    LDX dy : STA profile,X
    CPX disc_r : BEQ cols
    \ dy^2 grows by 2dy + 1: e += NOT(2dy) (the ASL clears carry)
    INC dy
    TXA : ASL A : EOR #&FF : ADC e : STA e
    BPL fits
.shrink
    \ x -= 1, so x^2 drops by 2x + 1 (of the new x)
    DEC x : LDA x : ASL A : SEC : ADC e : STA e
    BMI shrink
    BPL fits                                    ; (always)
.cols
    \ colspan[dx] = the largest dy whose row still reaches dx
    LDY disc_r
    LDX #0
.col
.down
    TXA : CLC : SBC profile,Y : BCC ok          ; borrows if dx <= profile[dy]
    DEY : BPL down                              ; (always: profile[0] >= dx)
.ok
    TYA : STA colspan,X
    CPX profile : INX : BCC col                 ; up to dx = profile[0]
    RTS
}

\ 8x8 unsigned multiply: A * X -> umul8.lo/hi. Preserves Y.
.umul8
{
    ZA_AUTO1 lo, hi, m
    STA m : STX hi
    LDA #0
    LDX #8
.bit
    \ Shift-add; the eight RORs push every old bit of lo out.
    LSR m : BCC @+ : CLC : ADC hi : .@
    ROR A : ROR lo
    DEX : BNE bit
    STA hi
    RTS
}
