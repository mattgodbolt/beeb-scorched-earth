\ ***************************************************************************
\ Graphics primitives: tables, pixels, spans, discs.
\ Nothing here goes through the OS.
\ ***************************************************************************

\ Build the row and column address tables.
.init_tables
{
    ZA_AUTO2 base
    LDA #LO(screen) : STA base
    LDA #HI(screen) : STA base+1
    LDY #0
.row
    TYA : AND #7 : CLC : ADC base : STA rowlo,Y
    LDA base+1 : ADC #0 : STA rowhi,Y
    INY : BEQ cols
    TYA : AND #7 : BNE row
    LDA base : CLC : ADC #LO(640) : STA base     ; next character row
    LDA base+1 : ADC #HI(640) : STA base+1
    JMP row
.cols
    LDX #0
.col
    TXA : AND #&FE : STA coloff_lo,X            ; (x >> 1) * 8 = (x & ~1) * 4
    LDA #0 : STA coloff_hi,X
    ASL coloff_lo,X : ROL coloff_hi,X
    ASL coloff_lo,X : ROL coloff_hi,X
    INX : CPX #SCREEN_W : BNE col
    RTS
}

\ Plot one pixel. X = x, Y = y, A = colour byte (both pixels; only the half
\ that belongs to x is used). Preserves X and Y.
.plot
{
    ZA_AUTO2 ptr
    ZA_AUTO1 col, ysave
    STA col : STY ysave
    LDA rowlo,Y : CLC : ADC coloff_lo,X : STA ptr
    LDA rowhi,Y : ADC coloff_hi,X : STA ptr+1
    LDY #0
    TXA : LSR A : BCS right
    LDA col : AND #LEFTPIX : STA col
    LDA (ptr),Y : AND #RIGHTPIX : ORA col : STA (ptr),Y
    LDY ysave
    RTS
.right
    LDA col : AND #RIGHTPIX : STA col
    LDA (ptr),Y : AND #LEFTPIX : ORA col : STA (ptr),Y
    LDY ysave
    RTS
}

\ The background colour byte at (X, Y), from the model: dirt at or below
\ the ground line, sky above it. Preserves X and Y.
.bgbyte
{
    TYA : CMP ground,X : BCS dirt
    LDA skyrow,Y
    RTS
.dirt
    LDA dirtrow,Y
    RTS
}

\ Put the background back at one pixel. X = x, Y = y.
.unplot
    JSR bgbyte
    JMP plot

\ Fill a horizontal run of pixels. Y = row, span_x0..span_x1 inclusive
\ (already clipped to the screen), A = colour byte.
ZA_AUTO1 span_x0, span_x1
.hspan
{
    ZA_AUTO2 ptr
    ZA_AUTO1 fill, t, n
    STA fill
    LDX span_x0
    LDA rowlo,Y : CLC : ADC coloff_lo,X : STA ptr
    LDA rowhi,Y : ADC coloff_hi,X : STA ptr+1
    LDA span_x1 : SEC : SBC span_x0 : TAY : INY : STY n   ; n = pixel count
    LDY #0
    TXA : LSR A : BCC even
    \ Odd start: the first byte gets its right pixel only.
    LDA fill : AND #RIGHTPIX : STA t
    LDA (ptr),Y : AND #LEFTPIX : ORA t : STA (ptr),Y
    LDY #8
    DEC n : BEQ done
.even
    LSR n : PHP                 ; n = whole bytes, carry = a left pixel over
    LDX n : BEQ tail
.whole
    LDA fill : STA (ptr),Y
    TYA : CLC : ADC #8 : TAY
    BCC @+ : INC ptr+1 : .@
    DEX : BNE whole
.tail
    PLP : BCC done
    LDA fill : AND #LEFTPIX : STA t
    LDA (ptr),Y : AND #RIGHTPIX : ORA t : STA (ptr),Y
.done
    RTS
}

\ Repaint byte column X (pixels 2X and 2X+1) from the model, rows
\ bg_y0..bg_y1 inclusive.
ZA_AUTO1 bg_y0, bg_y1
.draw_bgcol
{
    ZA_AUTO2 ptr
    ZA_AUTO1 gl, gr, t, y
    TXA : ASL A : TAX
    LDA ground,X : STA gl
    LDA ground+1,X : STA gr
    LDY bg_y0
.row
    LDA rowlo,Y : CLC : ADC coloff_lo,X : STA ptr
    LDA rowhi,Y : ADC coloff_hi,X : STA ptr+1
    CPY gl : BCS ldirt
    LDA skyrow,Y : BCC lpix
.ldirt
    LDA dirtrow,Y
.lpix
    AND #LEFTPIX : STA t
    CPY gr : BCS rdirt
    LDA skyrow,Y : BCC rpix
.rdirt
    LDA dirtrow,Y
.rpix
    AND #RIGHTPIX : ORA t
    STY y : LDY #0 : STA (ptr),Y : LDY y
    CPY bg_y1 : BEQ done
    INY
    JMP row
.done
    RTS
}

\ Repaint a rectangle from the model: pixels rect_x0..rect_x1 (clipped
\ here), rows bg_y0..bg_y1.
ZA_AUTO1 rect_x0, rect_x1
.repaint
{
    ZA_AUTO1 c, cend
    LDA rect_x1 : CMP #SCREEN_W : BCC @+ : LDA #SCREEN_W-1 : .@
    LSR A : STA cend
    LDA rect_x0 : LSR A : STA c                 ; (callers clip x0 at 0)
.loop
    LDX c : JSR draw_bgcol
    LDA c : CMP cend : BEQ done
    INC c : JMP loop
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ Discs. Everything round in the game is built from `profile`, the
\ half-width (in pixels) of each row of a disc of radius disc_r rows, and
\ `colspan`, the half-height (in rows) of each column. Pixels are about
\ twice as wide as they are tall, so a disc is half as wide in pixels as it
\ is tall in rows, and looks round.

ZA_AUTO1 disc_r, disc_cx, disc_cy

\ Build profile[0..disc_r] and colspan[0..profile[0]] for radius disc_r.
.make_profile
{
    ZA_AUTO1 x, dy
    ZA_AUTO2 xsq, dsq, lim, t
    LDA disc_r : STA x
    TAX : JSR umul8 : LDA umul8.lo : STA xsq    ; x^2
    LDA umul8.hi : STA xsq+1
    LDA xsq : CLC : ADC disc_r : STA lim        ; lim = r^2 + r: the midpoint
    LDA xsq+1 : ADC #0 : STA lim+1              ; circle's rounding
    LDA #0 : STA dsq : STA dsq+1 : STA dy
.row
    \ Shrink x until x^2 + dy^2 <= lim.
    LDA xsq : CLC : ADC dsq : STA t
    LDA xsq+1 : ADC dsq+1 : STA t+1
    LDA lim : CMP t
    LDA lim+1 : SBC t+1
    BCS fits
    \ x^2 -= 2x - 1, x -= 1
    LDA x : ASL A : STA t
    LDA xsq : SEC : SBC t : STA xsq
    LDA xsq+1 : SBC #0 : STA xsq+1
    INC xsq : BNE @+ : INC xsq+1 : .@
    DEC x
    JMP row
.fits
    \ profile[dy] = x / 2 to the nearest, halves rounding down
    LDA x : ASL A : ADC #1 : LSR A : LSR A
    LDX dy : STA profile,X
    CPX disc_r : BEQ cols
    \ dy^2 += 2dy + 1, dy += 1
    TXA : ASL A : SEC : ADC dsq : STA dsq
    LDA dsq+1 : ADC #0 : STA dsq+1
    INC dy
    JMP row
.cols
    \ colspan[dx] = the largest dy whose row still reaches dx
    LDY disc_r
    LDX #0
.col
    TXA
.down
    CMP profile,Y : BEQ ok : BCC ok
    DEY : JMP down
.ok
    TYA : STA colspan,X
    CPX profile : BEQ done
    INX : JMP col
.done
    RTS
}

\ 8x8 unsigned multiply: A * X -> umul8.lo/hi. Preserves Y.
.umul8
{
    ZA_AUTO1 lo, hi, m
    STA m
    LDA #0 : STA lo
    TXA : BEQ zero
    DEX : STX hi                ; add (X-1) + carry-in trick: shift-add
    LDA #0
    LDX #8
.bit
    LSR m : BCC @+ : ADC hi : .@
    ROR A : ROR lo
    DEX : BNE bit
    STA hi
    RTS
.zero
    STA hi
    RTS
}
