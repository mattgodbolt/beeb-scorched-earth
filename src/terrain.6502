\ ***************************************************************************
\ Terrain: generation, sky and dirt colouring, drawing.
\ The landscape is a heightmap: ground[x] is the first dirt row of column x.
\ ***************************************************************************

MIN_GROUND = 64             ; highest a peak may reach
MAX_GROUND = FLOOR - 12     ; lowest a valley may sink

\ 16-bit xorshift (John Metcalf's 7,9,8). Returns a fresh byte in A.
ZA_AUTO2 seed
.rand
    LDA seed+1
    LSR A
    LDA seed
    ROR A
    EOR seed+1
    STA seed+1
    ROR A
    EOR seed
    STA seed
    EOR seed+1
    STA seed+1
    RTS

\ Midpoint displacement over ground[0..160]: anchors every 32 columns,
\ then each level halves the gap and the bump size. terrain_amp is the
\ first level's bump mask (a power of two minus one): 63 is mountainous,
\ 15 gently rolling.
ZA_AUTO1 terrain_amp
.gen_terrain
{
    ZA_AUTO1 step, half, amp, hamp, mid, sum
    \ Anchors.
    LDX #0
.anchor
    JSR rand : AND #127 : CLC : ADC #MIN_GROUND+30
    STA ground,X
    TXA : ADC #32 : TAX                         ; (no carry: the sum was < 256)
    CPX #SCREEN_W+32 : BNE anchor
    LDA terrain_amp : STA amp : LSR A : STA hamp    ; hamp = amp / 2
    LDA #32 : STA step
    LSR A
.level
    STA half                                    ; step / 2
    TAY                                         ; i, the first point
.point
    \ ground[i] = mean of the neighbours half a step away, plus a bump.
    \ i stays in Y (rand leaves it alone). Carry is clear here: every way
    \ in has just shifted an even number right or failed a CMP.
    TYA : ADC half : TAX
    LDA ground,X : STA sum
    TXA : SEC : SBC step : TAX
    LDA ground,X : CLC : ADC sum : ROR A : STA mid
    JSR rand : AND amp : SEC : SBC hamp         ; bump in -amp/2 .. +amp/2
    \ No sum can wrap: mid is 64-221 (anchors reach MIN_GROUND+30+127)
    \ and the bump at most 32 either way.
    BMI down
    CLC : ADC mid : CMP #MAX_GROUND : BCC store
    LDA #MAX_GROUND
    BITABS                                      ; skip the ADC: MAX_GROUND
.down                                           ; passes the CMP and stores
    ADC mid : CMP #MIN_GROUND : BCS store       ; (no carry: the SBC borrowed)
    LDA #MIN_GROUND
.store
    STA ground,Y
    TYA : CLC : ADC step : TAY
    CMP #SCREEN_W+1 : BCC point
    LSR amp : LSR hamp
    LSR step
    LDA step : LSR A : BNE level                ; until step is 1
    RTS
}

\ Fill skyrow and dirtrow for this round's look: green dirt (no tank is
\ green) striped every eighth row in a colour of the round's choosing, and
\ half the time a "shaded" sky: black at the top, dithered towards blue by
\ the horizon. Patterns depend on the row alone, so anything can still be
\ repainted from the model.
.make_colours
{
    ZA_AUTO1 shaded, stripe
    JSR rand : AND #3 : TAX : LDA stripes,X : STA stripe
    JSR rand : LSR A : ROR shaded               ; bit 7: shaded
    LDX #0
.row
    LDA #0
    BIT shaded : BPL sky
    \ (y AND 3) * 4 + (y >> 6): each ASL's carry drops into the bit it
    \ has just cleared, so the ADCs never carry out.
    TXA : AND #&C3 : ASL A : ADC #0 : ASL A : ADC #0
    TAY : LDA sky_dither,Y
.sky
    STA skyrow,X
    TXA : AND #7 : BNE green
    LDA stripe
    BITABS                                      ; skip the green
.green
    LDA #cbyte(C_GREEN)
    STA dirtrow,X
    INX : BNE row
    RTS
    \ (stripes is in lowdata.6502.)
    \ By row within a group of four, then by quarter of the screen (top
    \ first): more blue the lower the quarter.
.sky_dither
    EQUB 0, lpix(C_BLUE), lpix(C_BLUE), lpix(C_BLUE)
    EQUB 0, 0, 0, lpix(C_BLUE) DIV 2
    EQUB 0, 0, lpix(C_BLUE) DIV 2, lpix(C_BLUE)
    EQUB 0, 0, 0, lpix(C_BLUE) DIV 2
}
