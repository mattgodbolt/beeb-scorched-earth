\ ***************************************************************************
\ Explosions, craters, dirt, and the things that fall afterwards.
\ ***************************************************************************

ZA_AUTO1 expl_r             ; radius of the current blast, in rows
ZA_AUTO1 fill_byte          ; colour byte for FILL_SOLID
ZA_AUTO1 fill_mode
FILL_SOLID = 0
FILL_SKY   = 1
FILL_DIRT  = 2

\ ---------------------------------------------------------------------------
\ The glow: logical colours 8-15 cycle through hot physical colours.

ZA_AUTO1 glow_phase
\ Stored EOR 7, the way the ULA's palette register wants them.
.hot_colours
    EQUB C_WHITE EOR 7, C_YELLOW EOR 7, C_YELLOW EOR 7, C_RED EOR 7
    EQUB C_RED EOR 7, C_YELLOW EOR 7, C_RED EOR 7, C_MAGENTA EOR 7

\ Advance the glow one step. Colour 8 + i shows hot_colours[(phase + i)
\ AND 7]; the loop steps glow_phase once per colour, so with the INC
\ first it moves on 9 a call, which is one step as far as AND 7 can see.
.glow
{
    INC glow_phase
    LDY #C_HOT << 4                             ; logical colour, top nibble
.loop
    LDA glow_phase : AND #7 : TAX : INC glow_phase
    TYA : ORA hot_colours,X : STA ula_pal
    TYA : CLC : ADC #&10 : TAY : BCC loop
    RTS
}

\ ---------------------------------------------------------------------------
\ Spans relative to the disc centre.

ZA_AUTO1 span_l, span_r

\ Fill the whole disc of radius disc_r.
.fill_disc
    JSR make_profile
    \ fall through

\ For dy = 0..disc_r, call the row routine with Y = each on-screen row of
\ the disc (two rows per dy, one for dy = 0) and X = dy. Rows are clipped
\ to TOP..FLOOR-1. Only the blast fills solid, and it draws ring by ring
\ (ring_row); sky and dirt fill whole discs (full_row).
ZA_AUTO1 row_dy
.disc_rows
{
    LDA #0 : STA row_dy
.loop
    LDA disc_cy : SEC : SBC row_dy : BCC below
    CMP #TOP : BCC below
    TAY : JSR do_row
.below
    LDA row_dy : BEQ next
    LDA disc_cy : CLC : ADC row_dy : BCS next
    CMP #FLOOR : BCS next
    TAY : JSR do_row
.next
    LDA row_dy : INC row_dy : CMP disc_r : BNE loop
    RTS
.do_row
    LDX row_dy
    LDA fill_mode : BEQ ring_row
}

\ A whole row of the disc.
.full_row
    LDA profile,X : STA span_r
    \ fall through
\ Row X of the disc from its left edge to span_r.
.left_part
    LDA profile,X : EOR #&FF : CLC : ADC #1 : STA span_l
    \ fall through

\ Fill row Y from disc_cx + span_l to disc_cx + span_r (signed offsets),
\ clipped to the screen, in the current fill_mode. Preserves Y (hspan
\ does).
\ disc_cx is on the screen and the offsets are at most MAX_R/2 either
\ way, so an end off the left edge wraps round to SCREEN_W or more, just
\ like one off the right: one compare finds both, and the offset's sign
\ says which edge it was.
.span_rel
{
    LDA span_r : CLC : ADC disc_cx : CMP #SCREEN_W : BCC rok
    BIT span_r : BMI off                        ; right end off the left edge
    LDA #SCREEN_W-1
.rok
    STA span_x1
    LDA span_l : CLC : ADC disc_cx : CMP #SCREEN_W : BCC lok
    BIT span_l : BPL off                        ; left end off the right edge
    LDA #0
.lok
    STA span_x0
    ASSERT FILL_SOLID = 0 AND FILL_SKY = 1 AND FILL_DIRT = 2
    LDA fill_byte
    LDX fill_mode : BEQ go
    LDA skyrow,Y : DEX : BEQ go
    LDA dirtrow,Y
.go
    JMP hspan
.off
    RTS
}

\ The part of a row of disc k that disc k-1 did not cover.
.ring_row
{
    LDA disc_r : LSR A : BEQ full_row           ; ring 1 is the whole disc
    CPX disc_r : BEQ full_row                   ; the new top and bottom rows
    LDA profile_prev,X : CMP profile,X : BCS span_rel.off  ; nothing new on this row
    \ left part: -p .. -q-1
    EOR #&FF : STA span_r                       ; -q-1
    JSR left_part
    \ right part: q+1 .. p
    LDX row_dy
    LDA profile_prev,X : CLC : ADC #1 : STA span_l
    LDA profile,X : STA span_r
    BNE span_rel                                ; (always: p > q >= 0)
}

\ ---------------------------------------------------------------------------
\ The blast: rings grow out from the centre in the eight hot colours, the
\ glow cycles them for a moment, and then the whole ball is gone, leaving
\ sky. disc_cx, disc_cy and expl_r say where and how big.

\ Ring k is drawn with disc_r = k.
.blast
{
    JSR glow
    ASSERT FILL_SOLID = 0
    LDA #FILL_SOLID : STA fill_mode
    STA profile                                 ; (the radius-0 disc)
    LDA #1 : STA disc_r
.ring
    \ keep the last ring's profile; fill_disc makes this one's
    LDX disc_r : DEX
.copy
    LDA profile,X : STA profile_prev,X
    DEX : BPL copy
    LDA disc_r : AND #7 : ORA #C_HOT : TAX : LDA cbytes,X : STA fill_byte
    JSR fill_disc
    \ Big blasts draw two rings a frame.
    LDA expl_r : CMP #16 : BCC sync
    LDA disc_r : LSR A : BCC nosync
.sync
    JSR wait_vsync : JSR glow
.nosync
    LDA disc_r : INC disc_r : CMP expl_r : BNE ring
    LDA #16 : STA disc_r                        ; (just a count, here)
.hold
    JSR wait_vsync : JSR wait_vsync : JSR glow
    DEC disc_r : BNE hold
    \ Gone: sky where the ball was.
    LDA #FILL_SKY : STA fill_mode
    LDA expl_r : STA disc_r
    JSR fill_disc
    \ fall through
}

\ Put logical colours 8-15 back to black.
.glow_off
{
    LDA #C_HOT << 4 OR 7
.loop
    STA ula_pal
    CLC : ADC #&10 : BCC loop
    RTS
}

\ ---------------------------------------------------------------------------
\ Craters and dirt. Both work column by column from colspan (for the disc
\ last built by make_profile) and queue up blocks of dirt to fall.

ZA_AUTO1 fall_n             ; columns in the fall queue

ZA_AUTO1 hole_top, hole_bot

\ Drop a ball of dirt: draw it, then add it to the model.
.add_dirt
    LDA #FILL_DIRT : STA fill_mode
    JSR fill_disc
    BEQ disc_cols                               ; (always: disc_rows ends Z set)

\ Carve the crater of the disc (disc_cx, disc_cy, disc_r) into the model.
.carve
    LDA #FILL_SKY : STA fill_mode               ; (sky is what is left)
    JSR make_profile
    \ fall through

\ For each column of the disc, call the column routine with X = screen
\ column and hole_top..hole_bot = the disc's rows there (clipped to
\ TOP..FLOOR-1): dirt_col when adding dirt, else carve_col. Starts the
\ fall queue afresh.
.disc_cols
{
    ZA_AUTO1 dx, t
    LDA #0 : STA fall_n
    LDA profile : EOR #&FF : CLC : ADC #1 : STA dx      ; -P
.loop
    \ (Off the left edge wraps round to SCREEN_W or more: see span_rel.)
    LDA dx : CLC : ADC disc_cx
    CMP #SCREEN_W : BCS next
    TAX
    LDA dx : BPL @+ : EOR #&FF : ADC #1 : .@    ; (carry clear)
    TAY : LDA colspan,Y : STA t
    LDA disc_cy : SEC : SBC t : BCC clamp_top : CMP #TOP : BCS @+
.clamp_top
    LDA #TOP
.@  STA hole_top
    LDA disc_cy : CLC : ADC t : BCS clamp_bot : CMP #FLOOR : BCC @+
.clamp_bot
    LDA #FLOOR-1
.@  STA hole_bot
    JSR do_col
.next
    LDA dx : INC dx : CMP profile : BNE loop    ; up to dx = P
    RTS
.do_col
    ASSERT FILL_SKY = 1 AND FILL_DIRT = 2
    LDA fill_mode : LSR A : BCC dirt_col
}

\ Blow a hole: the dirt in hole_top..hole_bot goes, and whatever was above
\ it drops by the hole's height.
.carve_col
{
    LDA hole_bot : CMP ground,X : BCC none      ; the hole is all sky here
    LDA ground,X : CMP hole_top : BCC floating
    \ The hole bit into the surface: the ground is now under it.
    LDA hole_bot : ADC #0 : STA ground,X        ; (carry set: +1)
.none
    RTS
.floating
    \ dirt from ground..hole_top-1 falls by hole_bot-hole_top+1
    TAY                                         ; (old ground, for the queue)
    LDA hole_top : SBC #0 : STA fall_b          ; (carry clear: -1)
    LDA hole_bot : SBC fall_b : STA fall_d      ; (carry set: no borrow)
    CLC : ADC ground,X : STA ground,X
    TYA
    JMP queue_fall
}

\ Add dirt: the part of hole_top..hole_bot that is above the ground drops
\ onto it.
.dirt_col
{
    LDA hole_top : CMP ground,X : BCS carve_col.none    ; all of it already dirt
    \ bottom of the new block: min(hole_bot, ground - 1)
    LDA ground,X : SBC #0                       ; (carry clear: -1)
    CMP hole_bot : BCC @+ : LDA hole_bot : .@
    STA fall_b
    \ it falls ground - 1 - fall_b ...
    LDA ground,X : CLC : SBC fall_b : STA fall_d
    \ ... and the ground rises by its height, fall_b - hole_top + 1, to
    \ hole_top + fall_d (never above TOP, as hole_top isn't)
    CLC : ADC hole_top : STA ground,X
    LDA fall_d : BEQ carve_col.none
    LDA hole_top
    \ fall through
}

\ Queue a block of dirt to fall: column X, rows A..fall_b, by fall_d.
ZA_AUTO1 fall_b, fall_d
.queue_fall
{
    LDY fall_n
    STA fall_top,Y
    TXA : STA fall_x,Y
    LDA fall_b : STA fall_bot,Y
    LDA fall_d : STA fall_dist,Y
    INC fall_n
    RTS
}

\ Let everything in the fall queue drop, a few rows a frame.
.run_falls
{
    ZA_AUTO1 i, moving, steps, under
.frame
    LDA #3 : STA steps
.step
    LDA fall_n : BEQ done
    LDX #0 : STX moving
.col
    STX i
    LDA fall_dist,X : BEQ next
    DEC fall_dist,X
    INC moving
    \ top pixel of the block becomes sky, the one under it becomes dirt
    LDY fall_top,X : INC fall_top,X
    INC fall_bot,X : LDA fall_bot,X : STA under
    LDA fall_x,X : TAX
    LDA skyrow,Y : JSR plot                     ; (plot keeps X and Y)
    LDY under : LDA dirtrow,Y : JSR plot
.next
    LDX i : INX : CPX fall_n : BNE col
    LDA moving : BEQ done
    DEC steps : BNE step
    JSR wait_vsync
    JMP frame
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ Damage. Every tank within reach of the blast loses health in proportion
\ to how close it was; shields soak it up first.

ZA_AUTO1 blast_power        ; damage at the very centre
.damage_tanks
{
    ZA_AUTO1 reach
    ZA_AUTO2 dsq
    LDA expl_r : CLC : ADC #3 : STA reach
    LDX #0
.tank
    STX cur
    LDA tank_alive,X : BEQ next
    LDA tank_health,X : BEQ next                ; dead already, just not gone
    \ dx in rows = 2 * |tank_x - cx|
    LDA tank_x,X : SEC : SBC disc_cx
    BCS @+ : EOR #&FF : ADC #1 : .@
    CMP #40 : BCS next
    ASL A : TAX : JSR umul8
    LDA umul8.lo : STA dsq : LDA umul8.hi : STA dsq+1
    \ dy = |tank_y - 2 - cy|
    LDX cur
    LDA tank_y,X : SEC : SBC #2 : SBC disc_cy   ; (tank_y > 2: carry set)
    BCS @+ : EOR #&FF : ADC #1 : .@
    CMP #80 : BCS next
    TAX : JSR umul8
    LDA umul8.lo : CLC : ADC dsq : STA dsq
    LDA umul8.hi : ADC dsq+1 : STA dsq+1
    \ dist = floor(sqrt(dsq)): the first d with d^2 > dsq, less one. Only a
    \ dist under reach matters, so stop looking there.
    LDY #0
.root
    CPY reach : BEQ next                        ; (reach >= 3: never at Y = 0)
    INY
    TYA : TAX : JSR umul8                       ; (preserves Y)
    LDA dsq : CMP umul8.lo
    LDA dsq+1 : SBC umul8.hi : BCS root
    \ damage = (reach - dist) * blast_power / reach, which is never more
    \ than blast_power, so fits in a byte. dist is Y - 1, and the carry is
    \ clear: reach + NOT(Y - 2) = reach - (Y - 2) - 1 = reach - dist.
    DEY : DEY : TYA : EOR #&FF : ADC reach
    LDX blast_power : JSR umul8
    LDA reach : JSR div16
    LDA umul8.lo : JSR hurt
.next
    LDX cur : INX : CPX num_players : BNE tank
    RTS
}

\ Tank `cur` takes A points of damage (shield first). Pays the attacker.
.hurt
{
    ZA_AUTO1 dmg
    STA dmg
    LDX cur
    LDA tank_shield,X : BEQ unshielded
    SEC : SBC dmg : BCC broke
    STA tank_shield,X
    RTS
.broke
    EOR #&FF : ADC #1 : STA dmg                 ; what got through
    LDA #0 : STA tank_shield,X
    \ The dome comes off the screen once the dirt has settled (explosion):
    \ repainting it now would put back dirt the blast has just removed.
    LDA shields_broke : ORA bit,X : STA shields_broke
.unshielded
    \ Only the health actually lost counts, so overkill pays no extra.
    LDA tank_health,X : CMP dmg : BCS @+ : STA dmg : .@
    SEC : SBC dmg : STA tank_health,X           ; (A is still the health)
    \ Damage pays the attacker - unless it was their own tank.
    LDA dmg : JSR damage_pay
    LDX attacker : CPX cur : BEQ own
    JMP money_add
.own
    JMP money_pay
}
ZA_AUTO1 attacker, shields_broke
.bit EQUB 1, 2, 4, 8, 16, 32

\ 16 / 8 divide of umul8's product (straight from a multiply, its only
\ use): umul8.lo/hi / A -> umul8.lo/hi, remainder in A.
.div16
{
    ZA_AUTO1 d
    STA d
    LDA #0
    LDX #16
.bit
    ASL umul8.lo : ROL umul8.hi : ROL A
    CMP d : BCC @+ : SBC d : INC umul8.lo : .@
    DEX : BNE bit
    RTS
}
