\ ***************************************************************************
\ The game: rounds, turns, aiming, firing.
\ ***************************************************************************

ZA_AUTO1 num_players, turns
MAX_TURNS = 50
ZA_AUTO1 wind               ; signed, -MAX_WIND..MAX_WIND (shown as x10)
MAX_WIND = 20

.main
{
    \ Seed from the system VIA timer: it has been running since power on.
    LDA &FE44 : STA seed
    LDA &FE45 : ORA #1 : STA seed+1
    LDA #2 : STA num_players
    LDA #10 : STA num_rounds
.game
    JSR setup
    \ However long the setup took is as good a random seed as any.
    LDA vsyncs : EOR seed : STA seed
    \ Everyone starts with nothing but Baby Missiles.
    \ (Counted down to zero, not with BPL: the table is more than 128
    \ bytes, and a BPL loop from 137 stops after one byte.)
    LDX #MAXP*NITEMS : LDA #0
.empty
    DEX : STA inv,X : BNE empty
    ASSERT MAXP*NITEMS <= 256
    LDX #MAXP*3-1
.broke
    STA tank_money,X : DEX : BPL broke
    LDX #MAXP-1
.fresh
    STA tank_score,X : STA tank_weapon,X
    DEX : BPL fresh
    STA round_no
.round
    INC round_no
    JSR new_round
    LDA #0 : STA turns : STA ff
    \ Who goes first rotates round by round.
    LDA round_no
.first
    SEC : SBC num_players : BCS first
    ADC num_players : STA cur
.turn
    LDX cur : LDA tank_alive,X : BEQ next
    STX attacker
    LDA tank_type,X : BNE computer
    JSR aim
    BCC shoot
    JMP game
.computer
    JSR ai_turn
.shoot
    JSR fire
    JSR spectators
    JSR count_alive : CMP #2 : BCC round_over
    \ Computers can stalemate - a tank behind a cliff in a headwind - so
    \ a round that drags on is called a draw.
    INC turns : LDA turns : CMP #MAX_TURNS : BCS stalemate
.next
    INC cur : LDA cur : CMP num_players : BNE turn
    LDA #0 : STA cur : JMP turn
.stalemate
    LDA #80 : JSR wait_frames
    LDX #&FF : BNE decided
.round_over
    \ The last tank standing scores and is paid; then the scores.
    LDA #0 : STA ff
    LDA #80 : JSR wait_frames
    LDX #&FF
    LDY #0
.find
    LDA tank_alive,Y : BEQ @+ : TYA : TAX : .@
    INY : CPY num_players : BNE find
.decided
    TXA : PHA : BMI nowin
    INC tank_score,X
    LDA #20 : JSR five_hundreds
    PLA : PHA : TAX : JSR money_add
    JSR snd_fanfare
.nowin
    PLA : JSR scores
    LDA round_no : CMP num_rounds : BEQ over
    JSR interest
    JSR shop
    JMP round
.over
    JSR champion
    JMP game
}

\ Once every human in the game is dead, nobody wants to watch the
\ computers finish the round at full speed: fast-forward it.
.spectators
{
    LDX #0 : LDY #0
.loop
    LDA tank_type,X : BNE next
    INY                                         ; a human...
    LDA tank_alive,X : BNE playing              ; ...still in it
.next
    INX : CPX num_players : BNE loop
    TYA : BEQ playing                           ; (an all-computer game)
    LDA #&80 : STA ff
.playing
    RTS
}

\ How many tanks are alive? -> A
.count_alive
{
    LDX #0 : LDA #0
.loop
    LDY tank_alive,X : BEQ @+ : CLC : ADC #1 : .@
    INX : CPX num_players : BNE loop
    RTS
}

\ A fresh landscape, wind and walls, and everyone back at full health.
.new_round
{
    ZA_AUTO1 twice
    JSR rand : AND #63 : ORA #31 : STA terrain_amp
    JSR gen_terrain
    JSR make_colours
    \ wind: the difference of two randoms, so a gale is rarer than a breeze
    JSR rand : AND #15 : STA wind
    JSR rand : AND #15 : EOR #&FF : SEC : ADC wind : STA wind
    \ wind_acc = wind * 6 (per-frame velocity change, 1/65536 px/substep).
    \ |wind| <= 15, so even x6 fits in a signed byte.
    ASL A : STA twice : ASL A
    LDX #0 : CLC : ADC twice : BPL @+ : DEX : .@
    STA wind_acc : STX wind_acc+1
    JSR rand : AND #3 : STA wall_type
    JSR place_tanks
    JSR clear_status
    JSR draw_terrain
    JMP draw_tanks
}

\ Spread the tanks out, flatten a pad under each, full health.
.place_tanks
{
    ZA_AUTO1 slot, width, x, t
    ZA_AUTO MAXP, order
    LDX num_players : LDA slot_widths-2,X : STA width
    \ Shuffle who gets which slot.
    LDX #MAXP-1
.ident
    TXA : STA order,X : ZA_INDEXEDBY 0..MAXP-1
    DEX : BPL ident
    LDX num_players : DEX
.shuffle
    JSR rand : AND #7 : CMP num_players : BCS shuffle
    TAY
    LDA order,X : ZA_INDEXEDBY 0..MAXP-1
    PHA
    LDA order,Y : ZA_INDEXEDBY 0..MAXP-1
    STA order,X : ZA_INDEXEDBY 0..MAXP-1
    PLA
    STA order,Y : ZA_INDEXEDBY 0..MAXP-1
    DEX : BNE shuffle
    LDA #0 : STA slot
.tank
    \ x = slot * width + width / 2 + jitter (+-width/4)
    LDA slot : LDX width : JSR umul8
    LDA width : LSR A : STA t
    CLC : ADC umul8.lo : STA x
    \ jitter: x += rand mod (width/2) - width/4
    JSR rand
.mod
    CMP t : BCC @+ : SBC t : BCS mod : .@      ; (SBC left carry set)
    LSR t
    CLC : ADC x : SEC : SBC t
    \ kept on the screen
    CMP #TANK_HALF+1 : BCS @+ : LDA #TANK_HALF+1 : .@
    CMP #SCREEN_W-TANK_HALF-1 : BCC @+ : LDA #SCREEN_W-TANK_HALF-2 : .@
    STA x
    LDY slot : LDX order,Y : ZA_INDEXEDBY 0..MAXP-1
    STA tank_x,X
    \ flatten the pad and stand on it
    TAY : LDA ground,Y : STA t
    SEC : SBC #1 : STA tank_y,X
    LDA #1 : STA tank_alive,X
    LDA #100 : STA tank_health,X
    LDA #0 : STA tank_shield,X : STA tank_tries,X
    \ aim at the middle of the screen, half power
    LDA #HI(500) : STA tank_power_hi,X
    LDA #LO(500) : STA tank_power_lo,X
    LDA #45
    LDY x : CPY #SCREEN_W/2 : BCC @+ : LDA #135 : .@
    STA tank_angle,X
    LDA x : SEC : SBC #TANK_HALF : TAY
    LDA t : LDX #2*TANK_HALF
.flatten
    STA ground,Y : INY : DEX : BPL flatten
    INC slot : LDA slot : CMP num_players : JNE tank
    RTS
}
\ The width of each tank's slot of the screen, by number of players.
.slot_widths
    EQUB SCREEN_W DIV (2..MAXP)

\ ---------------------------------------------------------------------------
\ Aiming. Left/right turn the turret, up/down change power (SHIFT for
\ fine steps), SPACE or RETURN fires. Returns carry set if ESCAPE was
\ pressed instead.

.aim
{
    ZA_AUTO1 held, k
    LDA #0 : STA held
    JSR clamp_power
    JSR draw_status
    JSR draw_tank
.frame
    JSR wait_vsync
    \ The first key in keys (from the end) that is down picks the handler.
    LDA #NKEYS-1 : STA k
.scan
    LDY k
    CPY #NKEYS-5 : BNE @+
    LDA #0 : STA held                           ; no arrow key is down
.@
    LDX keys,Y : JSR key_down : BNE found
    DEC k : BPL scan
    BMI frame
.found
    LDY k
    LDA go_hi,Y : PHA : LDA go_lo,Y : PHA
    RTS                                         ; not a return: a jump
    ZA_CANJUMP go
.keys
    EQUB K_RETURN, K_SPACE, K_S, K_B, K_ESCAPE, K_TAB
    EQUB K_DOWN, K_UP, K_RIGHT, K_LEFT
NKEYS = P% - keys
go = {fire, fire, shield, battery, quit, tab, down, up, right, left}
.go_lo
    EQUB LO(go - 1)
.go_hi
    EQUB HI(go - 1)
.fire
    CLC
    RTS
.quit
    SEC                                         ; ESCAPE: give up the game
    RTS
.tab
    JSR next_weapon
    JSR draw_weapon
.release
    JSR wait_vsync
    LDA #122 : JSR osbyte                       ; any key still down?
    CPX #&FF : BNE release
    JMP frame
.battery
    \ +10 health, up to 100
    LDA #I_BATTERY : JSR inv_index : LDA inv,X : BEQ release
    LDY cur : LDA tank_health,Y : CMP #100 : BCS release
    DEC inv,X
    ADC #10 : CMP #101 : BCC @+ : LDA #100 : .@
    STA tank_health,Y
    JSR snd_click
    JSR draw_status
    JMP release
.shield
    JSR raise_shield : BCC release
    JSR snd_click
    JMP release
.left
    LDX cur : LDA tank_angle,X : CMP #180 : BCS again
    JSR erase_barrel
    LDX cur : INC tank_angle,X
    JMP turned
.right
    LDX cur : LDA tank_angle,X : BEQ again
    JSR erase_barrel
    LDX cur : DEC tank_angle,X
.turned
    JSR draw_tank
    JSR draw_angle
.again
    JMP frame
.up
    JSR power_step
    LDX cur
    LDA tank_power_lo,X : CLC : ADC power_step.step : STA tank_power_lo,X
    LDA tank_power_hi,X : ADC #0 : STA tank_power_hi,X
    JSR clamp_power
    JMP powered
.down
    JSR power_step
    LDX cur
    LDA tank_power_lo,X : SEC : SBC power_step.step : STA tank_power_lo,X
    LDA tank_power_hi,X : SBC #0 : STA tank_power_hi,X
    BCS powered
    LDA #0 : STA tank_power_lo,X : STA tank_power_hi,X
.powered
    JSR draw_power
    JMP frame
}

\ Tank `cur` raises its strongest shield, if it has one and none is up
\ already: carry set if it did.
.raise_shield
{
    ZA_AUTO1 item
    LDY cur : LDA tank_shield,Y : BNE no
    \ the strongest one it owns
    LDA #I_HEAVY : STA item
.try
    LDA item : JSR inv_index : LDA inv,X : BNE got
    DEC item : LDA item : CMP #I_SHIELD : BCS try
    BCC no
.got
    DEC inv,X
    LDX item : LDA item_radius,X : LDY cur : STA tank_shield,Y
    JSR draw_tank
    SEC
    RTS
.no
    CLC
    RTS
}

\ How far one frame of holding up/down moves the power: 1 with SHIFT,
\ else 2, rising to 10 after half a second.
.power_step
{
    ZA_AUTO1 step
    LDA #1 : STA step
    LDX #K_SHIFT : JSR key_down : BNE done
    LDA #2 : STA step
    LDA aim.held : CMP #25 : BCS fast           ; (saturates: no wrapping)
    INC aim.held : BCC done
.fast
    LDA #10 : STA step
.done
    RTS
}

\ Max power is ten times health.
.clamp_power
{
    LDX cur : JSR max_power
    LDX cur
    LDA tank_power_lo,X : CMP num : LDA tank_power_hi,X : SBC num+1
    BCC ok
    LDA num : STA tank_power_lo,X
    LDA num+1 : STA tank_power_hi,X
.ok
    RTS
}

\ ---------------------------------------------------------------------------
\ Firing.

.fire
{
    LDX cur : LDA tank_weapon,X : STA weapon
    JSR use_weapon
    \ Tracers leave a trail in the firer's colour; everything else is a
    \ white dot.
    LDA #0 : STA shot_trail
    LDA #cbyte(C_WHITE) : STA shot_colour
    LDX weapon : LDA item_kind,X : CMP #SK_TRACER : BNE @+
    STA shot_trail
    LDX cur : LDA tank_colour,X : TAX : LDA cbytes,X : STA shot_colour
.@
    \ A riot charge has no shell: the blast is round your own turret,
    \ centred high enough that it barely digs under you.
    LDX weapon : LDA item_kind,X : CMP #SK_CHARGE : BNE shell
    LDA item_radius,X : STA expl_r
    LDA #0 : STA blast_power
    LDX cur : LDA tank_x,X : STA disc_cx
    LDA expl_r : LSR A : ADC #TANK_H : STA disc_cy   ; (r/2 + TANK_H above...)
    LDA tank_y,X : SEC : SBC disc_cy                 ; (...the tank's bottom)
    BCC @+ : CMP #TOP : BCS ok : .@
    LDA #TOP
.ok
    STA disc_cy
    JSR explosion
    JMP kill_dead
.shell
    LDX #MAXSH-1 : LDA #0
.clear
    STA sh_active,X : DEX : BPL clear
    \ Computers sometimes have something to say first.
    LDX cur : LDA tank_type,X : BEQ quiet
    JSR rand : AND #3 : BNE quiet
    JSR rand : AND #15 : CMP #ATTACK_LINES : BCS quiet
    JSR say
.quiet
    JSR launch
    JSR spawn_shell
    JSR snd_fire
    JSR fly_shells
    JMP kill_dead
}

\ Tanks whose health has run out blow up - which may finish off others.
.kill_dead
{
    ZA_AUTO1 shooter, i
    LDA cur : STA shooter
.again
    LDA #0 : STA i
.loop
    LDX i : LDA tank_alive,X : BEQ next
    LDA tank_health,X : BNE next
    LDA #0 : STA tank_alive,X
    \ A kill scores a point and $2500 - unless you killed yourself.
    CPX attacker : BEQ suicide
    LDX attacker : INC tank_score,X
    LDA #5 : JSR five_hundreds
    LDX attacker : JSR money_add
.suicide
    LDX i : STX cur
    JSR rand : AND #15 : CMP #DEATH_LINES : BCC @+ : LSR A : .@
    ADC #ATTACK_LINES : JSR say
    JSR erase_tank
    LDX i
    LDA tank_x,X : STA disc_cx
    LDA tank_y,X : SEC : SBC #2 : STA disc_cy
    LDA #12 : STA expl_r
    LDA #70 : STA blast_power
    JSR snd_die
    LDA shooter : STA cur
    JSR explosion
    JMP again
.next
    INC i : LDA i : CMP num_players : BNE loop
    LDA shooter : STA cur
    RTS
}

\ A blast at (disc_cx, disc_cy) of radius expl_r doing blast_power: the
\ fireball, the damage, the crater, the dirt and tanks falling, and any
\ tanks that die going up in turn.
.explosion
{
    ZA_AUTO1 shooter
    LDA cur : STA shooter
    LDA expl_r : JSR snd_explode
    LDA #0 : STA shields_broke
    JSR blast
    JSR damage_tanks
    LDA expl_r : STA disc_r
    LDA #0 : STA fall_n
    JSR carve
    JSR draw_tanks
    JSR run_falls
    \ Take away the domes of shields that just failed.
    LDA #0 : STA cur
.domes
    LSR shields_broke : BCC @+ : JSR erase_tank : .@
    INC cur : LDA cur : CMP #MAXP : BNE domes
    JSR draw_tanks
    JSR drop_tanks
    LDA shooter : STA cur
    RTS
}

\ Tanks with nothing under them fall to whatever is highest beneath them.
.drop_tanks
{
    ZA_AUTO1 land, i
    LDA #0 : STA cur
.tank
    LDX cur : LDA tank_alive,X : BEQ next
    \ land on the highest ground under the tank
    LDA tank_x,X : SEC : SBC #TANK_HALF : TAY
    LDA #FLOOR : STA land
    LDA #2*TANK_HALF+1 : STA i
.col
    LDA ground,Y : CMP land : BCS @+ : STA land : .@
    INY : DEC i : BNE col
    DEC land                                    ; the row above it
    LDA land : CMP tank_y,X : BEQ next : BCC next
    SEC : SBC tank_y,X : STA i                  ; how far it falls
.fall
    JSR erase_tank
    LDX cur : INC tank_y,X
    JSR draw_tank
    JSR wait_vsync
    LDX cur : LDA tank_y,X : CMP land : BNE fall
    \ A long fall hurts, unless a parachute opens.
    LDA i : CMP #6 : BCC next
    LDA #I_PARACHUTE : JSR inv_index : LDA inv,X : BEQ splat
    DEC inv,X : BPL next                        ; (always: 0-98 left)
.splat
    LDA i : JSR hurt
    JSR draw_tank
.next
    INC cur : LDA cur : CMP num_players : BNE tank
    RTS
}

\ ---------------------------------------------------------------------------
\ The status bar.

.clear_status
{
    LDA #0 : STA rect_x0 : STA bg_y0
    LDA #SCREEN_W-1 : STA rect_x1
    LDA #TOP-1 : STA bg_y1
    \ (the model is sky up here, and skyrow is black above TOP)
    JMP repaint
}

.draw_status
{
    PRINT_XY C_WHITE, 0, 2, "POWER"
    JSR draw_power
    PRINT_XY C_WHITE, 4*12, 2, "ANGLE"
    JSR draw_angle
    \ name, in the tank's colour
    LDX cur : LDA tank_colour,X : JSR ink
    LDA #4*24 : STA text_x
    LDX cur : JSR print_name
    LDA #4*34 : JSR pad_to
    \ wind
    LDA #C_CYAN : JSR ink
    LDA wind : BEQ calm : BPL east
    PRINT6 "<"
    LDA wind : EOR #&FF : CLC : ADC #1 : JSR wind_num
    JMP line2
.east
    JSR wind_num
    PRINT6 ">"
    JMP line2
.calm
    PRINT6 "CALM "
.line2
    JSR draw_weapon
    PRINT_XY C_WHITE, 4*21, 9, "HEALTH"
    LDX cur : LDA tank_health,X : LDX #4 : JSR print_byte
    \ the walls, in the original's colours
    LDX wall_type : LDA wall_colours,X : JSR ink
    LDA #4*32 : STA text_x
    LDA wall_type
    LDX #LO(wall_names) : LDY #HI(wall_names) : JMP print_packed_nth
.wind_num
    \ wind is shown x10, as the original's 0-200 scale
    LDX #10 : JSR times
    LDA #3 : JMP print_num
}

.draw_power
{
    LDA #4*6 : LDY #2 : JSR white_at
    LDX cur
    LDA tank_power_lo,X : STA num
    LDA tank_power_hi,X : STA num+1
    LDA #0 : STA num+2
    LDA #4 : JMP print_num
}

.wall_names
    PACKED "    OPEN" : PACKED "    WRAP" : PACKED "  RUBBER" : PACKED "CONCRETE"
.wall_colours
    EQUB C_WHITE, C_YELLOW, C_RED, C_WHITE

\ The selected weapon and how many are left.
.draw_weapon
{
    LDA #0 : LDY #9 : JSR white_at
    LDX cur : LDA tank_weapon,X : JSR print_item_name
    LDA #4*16 : JSR pad_to
    LDX cur : LDA tank_weapon,X : BEQ lots
    JSR inv_index : LDA inv,X : LDX #2 : JMP print_byte
.lots
    PRINT6 "--"
    RTS
}

\ The angle as the original shows it: 0-90 from the horizontal, with an
\ arrow for the side it faces.
.draw_angle
{
    LDA #4*18 : LDY #2 : JSR white_at
    LDX cur : LDA tank_angle,X
    LDY #62                                     ; >
    CMP #91 : BCC @+
    EOR #&FF : SEC : ADC #180
    LDY #60                                     ; <
.@  TAX : TYA : PHA : TXA                       ; the arrow, for after
    LDX #3 : JSR print_byte
    PLA : JMP draw_char
}

\ White text from (A, Y) in pixels.
.white_at
    STA text_x : STY text_y
    JMP white
