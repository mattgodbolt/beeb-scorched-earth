\ ***************************************************************************
\ Tanks: drawing, aiming, falling.
\ A tank is 7 pixels wide and 5 rows tall. tank_x is its centre column,
\ tank_y its bottom row (the row just above the ground it stands on).
\ The turret pivots on the top of the dome, one row above the body.
\ ***************************************************************************

TANK_HALF   = 3             ; columns either side of tank_x
TANK_H      = 5             ; rows
BARREL_LEN  = 7

\ Player colours: red, yellow, magenta, cyan, white, blue.
.player_colours
    EQUB C_RED, C_YELLOW, C_MAGENTA, C_CYAN, C_WHITE, C_BLUE

\ The body, top row first, bit 7 = leftmost column.
.tank_shape
    EQUB %00111000
    EQUB %01111100
    EQUB %11111110
    EQUB %11111110
    EQUB %01010100

\ Break an angle (0-180) into upward and sideways magnitudes.
\ In: A = angle. Out: vec_up = sin, vec_side = |cos|, vec_left = &FF if
\ the angle points left, else 0. Preserves Y.
ZA_AUTO1 vec_up, vec_side, vec_left
.angle_vec
{
    LDX #0
    CMP #91 : BCC right
    EOR #&FF : ADC #180                         ; 180 - a (carry was set)
    DEX
.right
    STX vec_left
    \ A is now 0-90 either way: the left angles are mirrored
    TAX : LDA sintab,X : STA vec_up
    \ cos a = sintab[90 - a]: index with 255 - a from a base 165 lower.
    TXA : EOR #&FF : TAX
    LDA sintab+90-255,X : STA vec_side
    RTS
}

ZA_AUTO1 cur                ; the player a routine is working on

\ A shield dot at column A (if it's on the screen), row Y.
.shield_dot
{
    CMP #SCREEN_W : BCS off
    TAX : LDA draw_body.col : JMP plot
.off
    RTS
}

\ Draw tank `cur`: body, shield, then barrel.
SHIELD_R = 8
.draw_tank
{
    ZA_AUTO1 dy
    JSR draw_body
    LDX cur : LDA tank_shield,X : BEQ noshield
    \ A shield is a dotted dome over the tank, in its colour. Top row
    \ down, so dy counts down while the row in Y counts up. (Every dot is
    \ the same colour: the order doesn't show.)
    LDA #SHIELD_R : STA disc_r : STA dy
    JSR make_profile
    LDX cur : LDA tank_y,X : SEC : SBC #2+SHIELD_R : TAY
.row
    CPY #TOP : BCC next                         ; (plot preserves Y)
    LDX dy : LDA profile,X : PHA
    EOR #&FF : SEC : LDX cur : ADC tank_x,X : JSR shield_dot   ; x - half
    PLA : CLC : LDX cur : ADC tank_x,X : JSR shield_dot        ; x + half
.next
    INY
    DEC dy : BPL row
.noshield
    LDA draw_body.col
    \ fall through
}

\ Draw (A = colour byte) or, via erase_barrel, undraw the barrel of
\ tank `cur` at its current angle.
.barrel
{
    ZA_AUTO1 col, k
    ZA_AUTO2 ax, ay
    STA col
    LDX cur
    LDA tank_angle,X : JSR angle_vec
    LDA #0 : STA ax : STA ax+1 : STA ay : STA ay+1
    LDA #BARREL_LEN : STA k
.point
    \ ax += cos, ay += sin; the point is (ax / 512, ay / 256) rounded:
    \ sideways distances are halved because pixels are twice as wide.
    LDA ax : CLC : ADC vec_side : STA ax
    BCC @+ : INC ax+1 : .@
    LDA ay : CLC : ADC vec_up : STA ay
    BCC @+ : INC ay+1 : .@
    \ row = tank_y - (TANK_H-1) - dy, dy = (ay + 128) / 256
    LDX cur
    LDA ay : CMP #128 : LDA ay+1 : ADC #TANK_H-1
    EOR #&FF : SEC : ADC tank_y,X : TAY
    CPY #TOP : BCC skip
    \ column = tank_x +- dx, dx = (ax + 256) / 512 (rounded up)
    LDA ax+1 : LSR A : ADC #0                   ; (leaves carry clear)
    BIT vec_left : BPL right
    EOR #&FF : SEC                              ; pointing left: subtract
.right
    ADC tank_x,X : TAX
    CPX #SCREEN_W : BCS skip
    LDA col : BNE draw
    JSR unplot                                  ; the background
    BNE skip                    ; (always: plot ends on LDY of the row, >= TOP)
.draw
    JSR plot
.skip
    DEC k : BNE point
    RTS
}

\ Take the barrel away (repainting the background under it), then redraw
\ the body in case the barrel crossed it.
.erase_barrel
    LDA #0 : JSR barrel
    \ fall through

\ Draw the body of tank `cur`.
.draw_body
{
    ZA_AUTO1 row, bits, col
    LDX cur
    LDA tank_colour,X : TAY : LDA cbytes,Y : STA col
    \ Y = y and X = x throughout: plot preserves both. Bottom row first.
    LDA tank_y,X : TAY
    LDA #TANK_H-1 : STA row
.rowloop
    LDX row : LDA tank_shape,X : STA bits
    LDX cur : LDA tank_x,X : SEC : SBC #TANK_HALF : TAX
.pix
    ASL bits : BCC skip
    CPX #SCREEN_W : BCS skip                    ; (clipped at the edges)
    LDA col : JSR plot
.skip
    INX
    LDA bits : BNE pix
    DEY
    DEC row : BPL rowloop
    RTS
}

\ Take a whole tank away: repaint its box and the space its barrel sweeps.
.erase_tank
{
    LDX cur
    LDA tank_x,X : CLC : ADC #TANK_HALF+3 : STA rect_x1
    SBC #2*(TANK_HALF+3)-1                      ; (carry clear: one more)
    BCS @+ : LDA #0 : .@
    STA rect_x0
    LDA tank_y,X : STA bg_y1
    SEC : SBC #TANK_H+BARREL_LEN : CMP #TOP : BCS @+ : LDA #TOP : .@
    STA bg_y0
    JMP repaint
}

\ Draw every live tank.
.draw_tanks
{
    LDA cur : PHA
    LDX #0 : STX cur
.loop
    LDA tank_alive,X : BEQ next
    JSR draw_tank
.next
    INC cur : LDX cur : CPX num_players : BNE loop
    PLA : STA cur
    RTS
}
