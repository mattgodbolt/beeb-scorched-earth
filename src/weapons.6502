\ ***************************************************************************
\ Weapons and items: the table, the inventory, and what each one does when
\ it lands.
\ ***************************************************************************

\ What a shell does when it lands. A shell's kind byte holds one of these
\ in its low nibble, leapfrog hops left in bits 4-5, and bit 7 set until
\ it has been clear of the tank that fired it.
SK_MISSILE = 0              ; explode
SK_TRACER  = 1              ; nothing
SK_ROLLER  = 2              ; roll downhill, then explode
SK_DIRT    = 3              ; add a ball of dirt
SK_RIOT    = 4              ; remove a ball of dirt, harm nobody
SK_FUNKY   = 5              ; explode and scatter bomblets
SK_BOMBLET = 6              ; a funky bomb's bomblet
SK_LEAP    = 7              ; explode and hop on
SK_MIRV    = 8              ; split at the top of the arc
SK_NAPALM  = 9              ; pour fire (napalm.6502)
SK_LIQUID  = 10             ; pour dirt (napalm.6502)
SK_CHARGE  = 11             ; no shell: clear the dirt round your own turret
SK_ITEM    = 15             ; not a weapon at all
UNARMED    = &80
HOP        = &10

\ Items, by inventory index (after the weapons).
\ name, kind, radius (rows), blast power, price ($), bundle, split count
\ (for napalm and liquid dirt, "radius" is how many units are poured and
\ "power" the damage a unit of fire does to a tank standing in it)
ITEMS = {
    {"BABY MISSILE",    SK_MISSILE,  6,  40,   400, 10, 0},
    {"MISSILE",         SK_MISSILE, 10,  90,  1875,  5, 0},
    {"BABY NUKE",       SK_MISSILE, 18, 120, 10000,  3, 0},
    {"NUKE",            SK_MISSILE, 32, 160, 12000,  1, 0},
    {"LEAPFROG",        SK_LEAP + 2 * HOP, 9, 80, 10000, 2, 0},
    {"FUNKY BOMB",      SK_FUNKY,   12,  80,  7000,  2, 0},
    {"MIRV",            SK_MIRV,    10,  90, 10000,  3, 5},
    {"DEATH'S HEAD",    SK_MIRV,    16, 120, 20000,  1, 9},
    {"TRACER",          SK_TRACER,   0,   0,    10, 20, 0},
    {"BABY ROLLER",     SK_ROLLER,   6,  60,  5000, 10, 0},
    {"ROLLER",          SK_ROLLER,  10,  90,  6000,  5, 0},
    {"HEAVY ROLLER",    SK_ROLLER,  18, 120,  6750,  2, 0},
    {"RIOT BOMB",       SK_RIOT,    14,   0,  5000,  5, 0},
    {"HEAVY RIOT BOMB", SK_RIOT,    22,   0,  4750,  2, 0},
    {"DIRT CLOD",       SK_DIRT,     8,   0,  5000, 10, 0},
    {"DIRT BALL",       SK_DIRT,    14,   0,  5000,  5, 0},
    {"TON OF DIRT",     SK_DIRT,    24,   0,  6750,  2, 0},
    {"NAPALM",          SK_NAPALM,  70,   2, 10000, 10, 0},
    {"HOT NAPALM",      SK_NAPALM, 120,   3, 20000,  2, 0},
    {"LIQUID DIRT",     SK_LIQUID, 100,   0,  5000, 10, 0},
    {"RIOT CHARGE",     SK_CHARGE,  12,   0,  2000, 10, 0},
    {"RIOT BLAST",      SK_CHARGE,  20,   0,  5000,  5, 0},
    {"PARACHUTE",       SK_ITEM,     0,   0, 10000,  8, 0},
    {"BATTERY",         SK_ITEM,     0,   0,  5000, 10, 0},
    {"SHIELD",          SK_ITEM,    60,   0, 20000,  3, 0},
    {"FORCE SHIELD",    SK_ITEM,   100,   0, 25000,  3, 0},
    {"HEAVY SHIELD",    SK_ITEM,   150,   0, 30000,  2, 0}
}
NITEMS     = LEN(ITEMS)
NWEAPONS   = NITEMS - 5
I_PARACHUTE = NWEAPONS
I_BATTERY   = NWEAPONS + 1
I_SHIELD    = NWEAPONS + 2  ; then FORCE SHIELD and HEAVY SHIELD: a
I_HEAVY     = NWEAPONS + 4  ; shield's strength is its "radius"
\ Only these two split, so `split` picks between them rather than keep a
\ table of split counts that is nearly all zeros.
I_MIRV        = 6
I_DEATHS_HEAD = 7
\ Inventory: inv[inv_base[player] + item]. (No hole below &0E00 is big
\ enough for it any more.)
.inv_base       EQUB (0..MAXP-1) * NITEMS
.inv            SKIP MAXP * NITEMS
ASSERT ITEMS[I_MIRV][1] = SK_MIRV AND ITEMS[I_DEATHS_HEAD][1] = SK_MIRV
FOR i = 0..NITEMS-1
    ASSERT ITEMS[i][6] = 0 OR i = I_MIRV OR i = I_DEATHS_HEAD
NEXT

.item_names
FOR i = 0..NITEMS-1
    EQUS ITEMS[i][0], 0
NEXT

\ Print item A's name.
.print_item_name
    LDX #LO(item_names) : LDY #HI(item_names)
\ Print string A of the zero-separated list at (X, Y).
.print_nth
    JSR find_nth
    JMP print_string
\ Find string A of the zero-separated list at (X, Y): address in A (lo)
\ and X (hi), and in find_nth.ptr.
.find_nth
{
    ZA_AUTO2 ptr
    STX ptr : STY ptr+1
    TAX
    LDY #0
.skip
    DEX : BMI found
.find
    LDA (ptr),Y
    INC ptr : BNE @+ : INC ptr+1 : .@
    CMP #0 : BNE find
    BEQ skip
.found
    LDA ptr : LDX ptr+1
    RTS
}

\ X = inventory index of item A for player `cur`.
.inv_index
    LDX cur
    CLC : ADC inv_base,X
    TAX
    RTS

\ Select the next weapon player `cur` owns any of (Baby Missiles never
\ run out).
.next_weapon
{
    LDX cur : LDY tank_weapon,X                 ; (inv_index preserves Y)
.try
    INY : TYA
    CPY #NWEAPONS : BCS wrap
    JSR inv_index : LDA inv,X : BEQ try
    TYA
    BITABS                                      ; (skip the LDA #0)
.wrap
    LDA #0
    LDX cur : STA tank_weapon,X
    RTS
}

\ Use up one of player `cur`'s selected weapon; drop back to Baby
\ Missiles when they run out.
.use_weapon
{
    LDY cur : LDA tank_weapon,Y : BEQ done      ; (inv_index preserves Y)
    JSR inv_index : DEC inv,X : BNE done
    LDA #0 : STA tank_weapon,Y
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ Shells in flight. A record is 16 bytes, laid out exactly like the zero
\ page block the ballistics work on, so a shell is flown by copying it
\ in, running a frame, and copying it out.


ZA_AUTO1 weapon             ; the weapon being fired
ZA_AUTO1 shell_i            ; the shell being worked on

\ Copy shell X into the zero page block.
.load_shell
{
    STX shell_i
    JSR shell_offset
.copy
    LDA shells,Y : STA shell,X : ZA_INDEXEDBY 0..15
    INY : INX : CPX #16 : BNE copy
    RTS
}

\ Copy the zero page block back into shell shell_i.
.save_shell
{
    JSR shell_offset
.copy
    LDA shell,X : ZA_INDEXEDBY 0..15 : STA shells,Y
    INY : INX : CPX #16 : BNE copy
    RTS
}

\ Y = shell_i's offset in shells, X = 0. (X indexes the zero page block:
\ zp,X is a byte shorter than abs,Y.)
.shell_offset
    LDA shell_i : ASL A : ASL A : ASL A : ASL A : TAY
    LDX #0
    RTS

\ Put the zero page shell into a free slot, if there is one.
.spawn_shell
{
    LDX #0
.find
    LDA sh_active,X : BEQ free
    INX : CPX #MAXSH : BNE find
    RTS
.free
    LDA #1 : STA sh_active,X
    LDA #0 : STA sh_drawn,X
    STX shell_i
    JMP save_shell
}

\ Fly every active shell until none are left, dealing with each as it
\ lands.
.fly_shells
{
    ZA_AUTO1 any, i
.frame
    LDA #0 : STA any : STA i
.shell_loop
    LDX i : LDA sh_active,X : BEQ next
    JSR load_shell
    JSR shell_frame
    BCC moved
    \ It landed: take its dot away and let the weapon do its thing.
    LDX i : LDA #0 : STA sh_active,X
    JSR undraw_shell
    JSR land
    JMP next
.moved
    JSR save_shell
    INC any
    \ MIRVs split once they start to fall.
    LDA shot_kind : AND #15 : CMP #SK_MIRV : BNE next
    LDA shot_vy+2 : BMI next
    JSR split
.next
    INC i : LDA i : CMP #MAXSH : BNE shell_loop
    LDA any : BEQ done
    JSR wait_vsync
    JSR draw_shells
    JSR flight_sound
    JMP frame
.done
    RTS
}

\ Redraw every shell's dot at its new position.
.draw_shells
{
    ZA_AUTO1 i
    LDA #0 : STA i
.loop
    LDX i : LDA sh_active,X : BEQ next
    LDA shot_trail : BNE keep
    JSR undraw_shell
.keep
    LDA i : ASL A : ASL A : ASL A : ASL A : TAY
    LDA shells+3,Y : BNE next                   ; x off screen
    LDA shells+7,Y : BNE next                   ; y off screen
    LDA shells+2,Y : CMP #SCREEN_W : BCS next
    LDA shells+6,Y : CMP #TOP : BCC next
    LDX i : STA sh_oldy,X : PHA
    STA sh_drawn,X                              ; (the row: never 0)
    LDA shells+2,Y : STA sh_oldx,X
    TAX : PLA : TAY
    LDA shot_colour : JSR plot
.next
    INC i : LDA i : CMP #MAXSH : BNE loop
.done
    RTS
}

\ Take shell X's dot off the screen, if it is on it.
.undraw_shell
{
    LDA sh_drawn,X : BEQ draw_shells.done
    LDA #0 : STA sh_drawn,X
    LDY sh_oldy,X : LDA sh_oldx,X : TAX
    JMP unplot
}

\ The MIRV in the zero page block becomes the split count (ITEMS) of
\ warheads, fanned out sideways around its own velocity.
.split
{
    ZA_AUTO1 n, k
    \ Both counts are odd and at least 3, so the loops below needn't test
    \ for zero up front.
    ASSERT ITEMS[I_MIRV][6] >= 3 AND (ITEMS[I_MIRV][6] AND 1) = 1
    ASSERT ITEMS[I_DEATHS_HEAD][6] >= 3 AND (ITEMS[I_DEATHS_HEAD][6] AND 1) = 1
    \ n = the warheads still to spawn after this one
    LDA #ITEMS[I_MIRV][6]-1
    LDX weapon : CPX #I_DEATHS_HEAD : BNE @+
    LDA #ITEMS[I_DEATHS_HEAD][6]-1
.@  STA n
    \ start the fan at vx - (n/2) * spread
    LSR A : STA k
    LDA #SK_MISSILE : STA shot_kind
.back
    LDA #LO(-SPREAD) : LDX #HI(-SPREAD) : JSR add_vx
    DEC k : BNE back
    \ the first warhead replaces the MIRV itself
    JSR save_shell
.more
    LDA #LO(SPREAD) : LDX #HI(SPREAD) : JSR add_vx
    JSR spawn_shell
    DEC n : BNE more
    RTS
SPREAD = 2200
}

\ ---------------------------------------------------------------------------
\ Landing.

\ A ball of dirt lands at (disc_cx, disc_cy), radius expl_r.
.dirt_ball
{
    LDA expl_r : STA disc_r
    LDA #0 : STA fall_n
    JSR add_dirt
    JSR run_falls
    JMP draw_tanks
}

\ The shell in the zero page block has landed (hit_kind, hit_x, hit_y).
\ A Riot Bomb is an explosion like any other: its blast power is 0.
.land
{
    LDA hit_kind : CMP #HIT_LOST : BEQ none
    LDA hit_x : STA disc_cx
    LDA hit_y : STA disc_cy
    LDX weapon
    LDA item_radius,X : STA expl_r
    LDA item_power,X : STA blast_power
    LDA shot_kind : AND #15 : TAX
    LDA land_hi,X : PHA : LDA land_lo,X : PHA
    RTS                                         ; not a return: a jump
    ZA_CANJUMP landings
\ What each SK_ kind does, in order. (Riot Charges never fly.)
landings = {explosion, none, roller, dirt_ball, explosion, funky, bomblet, leap, explosion, napalm, liquid_dirt}
ASSERT LEN(landings) = SK_LIQUID + 1 AND SK_CHARGE > SK_LIQUID
.land_lo
    EQUB LO(landings - 1)
.land_hi
    EQUB HI(landings - 1)
.none
    RTS
.bomblet
    LDA #7 : STA expl_r
    LDA #50 : STA blast_power
    BNE boom                                    ; (always)
.roller
    LDA hit_kind : CMP #HIT_TANK : BEQ boom : JSR roll
.boom
    JMP explosion
.leap
    JSR explosion
    LDA shot_kind : AND #3*HOP : BEQ none
    SEC : SBC #HOP : ORA #SK_LEAP : STA shot_kind
    \ bounce: up at half the speed it came down, a bit slower sideways
    LDX #4 : JSR negate_vel                     ; (A = vy's top byte)
    CMP #&80 : ROR A : STA shot_vy+2
    ROR shot_vy+1 : ROR shot_vy
    LDA hit_y : SEC : SBC #3 : STA shot_y+2
    LDA #0 : STA shot_y+3
    JMP spawn_shell
.funky
    JSR explosion
    \ fall through
}

\ A Funky Bomb throws six bomblets up and out from where it burst.
.scatter
{
    ZA_AUTO1 n
    LDA #6 : STA n
    LDA disc_cy : SEC : SBC #4 : STA shot_y+2
.more
    LDA #SK_BOMBLET : STA shot_kind
    LDA hit_x : STA shot_x+2
    LDA #0 : STA shot_x+3 : STA shot_y+3 : STA shot_vx : STA shot_vy
    \ vx: random, +-0.25 px/substep; vy: up, 0.25-0.75 rows/substep
    LDX #0
    JSR rand : CMP #&80 : ROR A : STA shot_vx+1 ; /2, keeping sign
    BPL @+ : DEX : .@
    STX shot_vx+2
    JSR rand : AND #&3F : EOR #&BF : STA shot_vy+1  ; NOT (&40 + 0..&3F)
    LDA #&FF : STA shot_vy+2
    JSR spawn_shell
    DEC n : BNE more
    RTS
}

\ A roller rolls downhill from where it landed until it reaches a valley,
\ a tank or the edge, and the blast happens there (disc_cx, disc_cy).
.roll
{
    ZA_AUTO1 x, dir
    LDX hit_x : STX x
    \ which way is down?
    LDA ground-1,X : CMP ground+1,X : BEQ stop
    LDA #1 : BCC @+ : LDA #&FF : .@
    STA dir
.step
    LDA x : CLC : ADC dir : TAX
    CPX #SCREEN_W : BCS stop                    ; (0 - 1 wraps to 255)
    LDY x : LDA ground,X : CMP ground,Y : BCC stop  ; uphill: settled
    \ move the ball
    LDA x : STA hit_x
    STX x
    LDY ground,X : DEY : STY hit_y
    STX shot_x+2 : STY shot_y+2
    \ (tank_at, plot and wait_vsync all leave Y alone; the last two X too)
    JSR tank_at : BCS stop
    LDX x : LDA shot_colour : JSR plot
    JSR wait_vsync
    JSR unplot
    JMP step
.stop
    LDX x : STX disc_cx
    LDY ground,X : DEY : STY disc_cy
    RTS
}
