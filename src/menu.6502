\ ***************************************************************************
\ Between the shooting: title and setup, the shop, the scores, and money.
\ These screens read the keyboard through OSRDCH (with *FX 4,1 the cursor
\ keys arrive as codes 136-139) - they wait for people, so speed is no
\ object.
\ ***************************************************************************

osrdch    = &FFE0
KEY_LEFT  = 136
KEY_RIGHT = 137
KEY_DOWN  = 138
KEY_UP    = 139
KEY_RET   = 13

ZA_AUTO1 num_rounds, round_no, menu_sel

\ Black out the whole screen.
.cls
{
    ZA_AUTO2 ptr
    LDA #LO(screen) : STA ptr
    LDA #HI(screen) : STA ptr+1
    LDA #0 : TAY
.loop
    STA (ptr),Y
    INY : BNE loop
    INC ptr+1 : BPL loop
    RTS
}

\ Wait for a keypress (after throwing away any typed ahead) -> A.
.get_key
{
    LDA #15 : LDX #1 : JSR osbyte
    JSR osrdch
    PHA : JSR snd_click : PLA
    RTS
}

\ Move the text cursor to column A, line X (lines are 7 rows apart: one
\ more than the font needs, for room between them).
.at
{
    ASL A : ASL A : STA text_x
    STX text_y
    TXA : ASL A : ASL A : ASL A                 ; (no carry: lines < 32)
    SEC : SBC text_y : STA text_y
    RTS
}

\ Packed text (the PACKED macro is in text.6502).
ZA_AUTO2 tptr               ; the next byte of packed text
ZA_AUTO1 tbits              ; what is left of the last one, then a 1

\ The next character of packed text -> A, with Z set at the end.
\ tbits must start at &80 (empty) for each string.
.unpack
{
    JSR five : BNE plain
    JSR five : ADC #31                          ; escaped: +32 (and not 0)
    RTS
.plain
    ADC #63 : CMP #95                           ; (+64: the carry is set)
    RTS
\ The next five bits -> A, with Z set if they are 0, and carry set.
.five
    LDA #8                                      ; shifts out after 5 bits
.bit
    ASL tbits : BNE got
    PHA : JSR fetch : SEC : ROL A : STA tbits : PLA
.got
    ROL A : BCC bit
    RTS
}

\ The byte at tptr -> A, and tptr moves on.
.fetch
{
    LDY #0 : LDA (tptr),Y
    INC tptr : BNE @+ : INC tptr+1 : .@
    RTS
}

\ Point tptr at packed string A of the list at (X lo, Y hi), unpacking its
\ way past the ones before it. Leaves X = &FF.
.packed_nth
{
    STX tptr : STY tptr+1
    TAX
.skip
    LDA #&80 : STA tbits                        ; each string starts a byte
    DEX : BMI found
.@  JSR unpack : BNE @-
    BEQ skip
.found
    RTS
}

\ Print packed string A of the list at (X, Y).
.print_packed_nth
    JSR packed_nth
    \ (on into print_packed)

\ Print packed text from tptr.
.print_packed
{
    LDA #&80 : STA tbits
.loop
    JSR unpack : BEQ done
    JSR draw_char : BNE loop                    ; (A = text_x, never 0)
.done
    RTS
}

\ Print packed text given inline after the JSR, as print_inline once did:
\     JSR print6 : PACKED "TEXT"
\ or put it somewhere in some colour first:
\     JSR print_at : EQUB x, y, colour : PACKED "TEXT"
\ with x and y in pixels. Most of the text on the screens between rounds
\ is placed like this; the PRINT_AT macro takes columns and lines.
.print_at
    SEC : BITZP                                 ; (swallows the CLC)
.print6
    CLC
{
    PLA : STA tptr : PLA : STA tptr+1           ; (carry survives to BCC)
    JSR fetch                                   ; the JSR's own last byte
    BCC text
    JSR fetch : STA text_x
    JSR fetch : STA text_y
    JSR fetch : JSR ink
.text
    JSR print_packed
    JMP (tptr)                                  ; just past the text
    ZA_RETURN
}

\ Print spaces (at least one) up to pixel column A.
.pad_to
{
    ZA_AUTO1 to
    STA to
.pad
    LDA #32 : JSR draw_char                     ; -> A = text_x
    CMP to : BCC pad
    RTS
}

MACRO PRINT6 text
    JSR print6 : PACKED text
ENDMACRO
MACRO PRINT_XY colour, x, y, text
    JSR print_at : EQUB x, y, colour : PACKED text
ENDMACRO
MACRO PRINT_AT colour, col, line, text
    PRINT_XY colour, col * 4, line * 7, text
ENDMACRO

\ Print player X's name in its colour: "PLAYER 1", or the personality for
\ a computer.
.print_name
{
    ZA_AUTO1 t
    STX t
    LDA tank_colour,X : JSR ink
    LDX t : LDA tank_type,X
    LDX #LO(type_names) : LDY #HI(type_names)
    JSR print_packed_nth
    LDA #32 : JSR draw_char
    LDA t : ADC #49 : JMP draw_char             ; (draw_char leaves carry clear)
}
.type_names
    PACKED "PLAYER" : PACKED "MORON" : PACKED "SHOOTER"
    PACKED "TOSSER" : PACKED "SPOILER" : PACKED "CYBORG"

\ Where each player's money starts in tank_money: three bytes apiece.
.times3
    EQUB (0..MAXP-1) * 3

\ num = player X's money.
.get_money
{
    LDY times3,X : LDX #0
.copy
    LDA tank_money,Y : STA num,X : ZA_INDEXEDBY 0..2
    INY : INX : CPX #3 : BNE copy
    RTS
}

\ Print player X's money in 7 columns, with a dollar sign.
.print_money
    JSR get_money
    LDA #FONT_DOLLAR : JSR draw_char
    LDA #6 : JMP print_num

\ Carry set if player X has num dollars, with Y = where the money is in
\ tank_money.
.can_afford
    LDY times3,X
    LDA tank_money,Y : CMP num
    LDA tank_money+1,Y : SBC num+1
    LDA tank_money+2,Y : SBC num+2
    RTS

\ Player X pays num dollars if they can: carry set if paid, clear (and
\ nothing taken) if not.
.money_pay
    JSR can_afford : BCC poor
    \ Taking num away is adding its complement with the carry set, which
    \ it is: the money_add loop does both.
    LDA #&FF : BNE add_money

\ Player X gains num dollars.
.money_add
    LDY times3,X
    LDA #0 : CLC
\ Add num EOR A (0 or &FF) and the carry to the money at tank_money+Y.
.add_money
{
    ZA_AUTO1 flip
    STA flip
    LDX #0
.byte
    LDA num,X : ZA_INDEXEDBY 0..2
    EOR flip : ADC tank_money,Y : STA tank_money,Y
    INY : INX : TXA : EOR #3 : BNE byte         ; (not CPX: it would lose the carry)
}
.poor
    RTS

\ num = tank X's greatest power: ten times its health.
.max_power
    LDA tank_health,X : LDX #10 : BNE times

\ num = A * 50: what a point of damage pays.
.damage_pay
    LDX #50
\ num = A * X.
.times
    STA mul16.m : LDA #0 : STA mul16.m+1
    TXA
\ num = mul16.m * A.
.times16
{
    JSR mul16
    LDX #2
.copy
    LDA mul16.r,X : ZA_INDEXEDBY 0..2
    STA num,X : ZA_INDEXEDBY 0..2
    DEX : BPL copy
    RTS
}

\ num = A * 500.
.five_hundreds
    LDX #LO(500) : STX mul16.m : LDX #HI(500) : STX mul16.m+1
    BNE times16

\ ---------------------------------------------------------------------------
\ Title and setup.

\ The OS still thinks the screen starts at &3000, so its text row r lands
\ on our row r - (32 - SCREEN_ROWS). Big letters on our character row 1,
\ one colour each: letter i is in COLOUR (i AND 7) + 1, or (i AND 7) - 4
\ from 6 on (1-6, then round again from 2).
.title_vdu
    EQUB 31, 3, 1 + 32 - SCREEN_ROWS
.title_text
    EQUS "SCORCHED EARTH"
.title_end

\ Clear the screen and put the title on it.
.draw_title
{
    JSR cls
    LDX #0
.loop
    CPX #title_text - title_vdu : BCC plain
    LDA #17 : JSR oswrch                        ; (OSWRCH keeps X)
    TXA : SEC : SBC #title_text - title_vdu     ; i
    AND #7 : CMP #6 : BCC @+ : SBC #6 : .@      ; (and SBC sets it again)
    ADC #1 : JSR oswrch
.plain
    LDA title_vdu,X : JSR oswrch
    INX : CPX #title_end - title_vdu : BNE loop
    PRINT_AT C_WHITE, 8, 4, "THE MOTHER OF ALL GAMES"
    PRINT_AT C_CYAN, 7, 31, "AFTER WENDELL HICKEN 1991"
    PRINT_AT C_BLUE, 0, 0, build_stamp
    RTS
}

\ The setup screen: players, rounds and who is playing. Returns when
\ SPACE or RETURN is pressed.
.setup
{
    ZA_AUTO1 i
    JSR draw_title
    LDA #0 : STA menu_sel
.redraw
    \ (wider number fields print the spaces, which is shorter than packing
    \ them)
    PRINT_AT C_YELLOW, 7, 8, "PLAYERS"
    LDA num_players : LDX #3 : JSR print_byte
    PRINT_AT C_YELLOW, 7, 10, "ROUNDS"
    LDA num_rounds : LDX #4 : JSR print_byte
    \ a line for each menu item: the marker, then for a player its name
    LDA #0 : STA i
.item
    LDA i : ASL A : ADC #8 : TAX : LDA #5 : JSR at
    JSR white
    LDA #32 : LDX i : CPX menu_sel : BNE @+ : LDA #62 : .@
    JSR draw_char
    JSR draw_char                               ; (A = text_x: a space)
    LDX i : DEX : DEX : BMI next                ; the two settings
    CPX num_players : BCS blank
    JSR print_name
.blank
    \ spaces rub out a longer name, or a player no longer in the game
    LDA #4*18 : JSR pad_to
.next
    INC i : LDA i : CMP #MAXP+2 : BNE item
    PRINT_AT C_WHITE, 4, 26, "UP/DOWN CHOOSE  LEFT/RIGHT CHANGE"
    PRINT_AT C_WHITE, 11, 28, "SPACE TO START"
.key
    JSR get_key
    CMP #32 : BEQ go
    CMP #KEY_RET : BEQ go
    LDX menu_sel
    CMP #KEY_UP : BNE @+ : DEX : BMI key : BPL select : .@
    CMP #KEY_DOWN : BNE @+
    \ items: 2 settings + players, so the last is num_players + 1
    CPX num_players : BEQ down : BCS key
.down
    INX : BNE select : .@                       ; (always)
    SEC : SBC #KEY_LEFT : CMP #2 : BCS key      ; 0 left, 1 right
    \ -1 or +1 to the selected setting, as i + carry: &FF + 0 or 0 + 1
    SBC #0 : STA i
    DEX : BPL rounds
    LDA num_players : ADC i
    CMP #2 : BCC key : CMP #MAXP+1 : BCS key
    STA num_players : BCC again                 ; (always)
.rounds
    DEX : BPL type
    LDA num_rounds : ADC i
    BEQ key : CMP #100 : BCS key
    STA num_rounds : BCC again                  ; (always)
.type
    LDA tank_type,X : ADC i                     ; (X = the player now)
    BPL @+ : LDA #NTYPES-1 : .@
    CMP #NTYPES : BCC @+ : LDA #0 : .@
    STA tank_type,X
    BITABS                                      ; (swallows the STX)
.select
    STX menu_sel
.again
    JMP redraw
.go
    RTS
}


\ ---------------------------------------------------------------------------
\ The shop. Players take turns; the computers just buy.

.shop
{
    LDA #0 : STA cur
.player
    LDX cur : LDA tank_type,X : BEQ human
    JSR ai_shop
    BEQ next                                    ; (ai_shop leaves Z set)
.human
    JSR shop_human
.next
    INC cur : LDA cur : CMP num_players : BNE player
    RTS
}

.shop_human
{
    ZA_AUTO1 i
    JSR cls
    LDA #1 : STA menu_sel : STA shop_top
    LDX #0 : JSR at                             ; (A = 1: column 1)
    LDX cur : JSR print_name
    PRINT6 " GOES SHOPPING"
    \ (a run of spaces costs more than another PRINT_AT)
    PRINT_AT C_CYAN, 1, 1, "ITEM"
    PRINT_AT C_CYAN, 18, 1, "QTY  PRICE OWNED"
    PRINT_AT C_CYAN, 5, 30, "RETURN BUYS   SPACE TO FIGHT"
.redraw
    \ (shop_line leaves out the items scrolled out of sight)
    LDA #1 : STA i
.all
    LDA i : JSR shop_line
    INC i : LDA i : CMP #NITEMS : BNE all
    JSR white
    LDA #31 : LDX #0 : JSR at
    LDX cur : JSR print_money
.key
    JSR get_key
    CMP #32 : BEQ done
    LDX menu_sel
    CMP #KEY_UP : BNE notup
    CPX #1 : BEQ key
    DEC menu_sel : BPL moved                    ; (always: it was 2 or more)
.notup
    CMP #KEY_DOWN : BNE notdown
    CPX #NITEMS-1 : BEQ key
    INC menu_sel
.moved
    \ Two pages: the first SHOP_ROWS items and the last. Leaving one for
    \ the other redraws the list. (A line at a time redrew it so often
    \ that keys were lost while it did.)
    LDA menu_sel : SEC : SBC shop_top : BCC flip_up
    CMP #SHOP_ROWS : BCC seen
    LDA #NITEMS-SHOP_ROWS : BNE flipped         ; (always)
.flip_up
    LDA #1
.flipped
    STA shop_top : BNE redraw                   ; (always)
.seen
    TXA : JSR shop_line                         ; un-highlight the old line
    LDA menu_sel : JSR shop_line
    JMP key
.notdown
    CMP #KEY_RET : BNE key
    LDA menu_sel : JSR buy : BCC key
    BCS redraw                                  ; what's affordable changed
.done
    RTS
}

\ The shop lists SHOP_ROWS items at a time, from item shop_top, on lines 2
\ onwards: the footer is on line 30. Two pages show every item.
SHOP_ROWS = 28
ASSERT NITEMS - 1 <= 2 * SHOP_ROWS
ZA_AUTO1 shop_top

\ Draw shop line A (an item), if it is scrolled into view: highlighted if
\ selected, red if it is out of reach.
.shop_line
{
    ZA_AUTO1 item, line
    STA item
    SEC : SBC shop_top : CMP #SHOP_ROWS : BCS hidden    ; (above: it wraps)
    ADC #2 : STA line
    LDX #C_YELLOW : LDA item : CMP menu_sel : BEQ colour
    JSR price : LDX cur : JSR can_afford
    LDX #C_WHITE : BCS colour
    LDX #C_RED
.colour
    TXA : JSR ink
    LDX line : LDA #1 : JSR at
    LDA item : JSR print_item_name
    LDA #4*18 : JSR pad_to
    \ (the wide fields leave the spaces between the columns)
    LDX item : LDA item_bundle,X : LDX #2 : JSR print_byte
    LDA item : JSR price : LDA #7 : JSR print_num
    LDA item : JSR inv_index : LDA inv,X : LDX #5 : JMP print_byte
.hidden
    RTS
}
\ num = the price of item A.
.price
{
    TAX
    LDA item_price_lo,X : STA num
    LDA item_price_hi,X : STA num+1
    LDA #0 : STA num+2
    RTS
}

\ Player `cur` buys a bundle of item A if they can afford it and have
\ room for it. Carry set if they did.
.buy
{
    ZA_AUTO1 t
    STA t
    JSR inv_index : LDA inv,X : CMP #99 : BCS no
    TXA : PHA                                   ; where it goes, for later
    LDA t : JSR price
    LDX cur : JSR money_pay
    PLA : TAX : BCC no
    LDY t : LDA inv,X : CLC : ADC item_bundle,Y
    CMP #99 : BCC @+ : LDA #99 : .@
    STA inv,X
    SEC
    RTS
.no
    CLC
    RTS
}

\ A computer player goes shopping: a dozen goes at picking something it
\ likes, buying it when it can.
.ai_shop
{
    ZA_AUTO1 tries
    LDA #12 : STA tries
.try
    JSR rand : AND #15 : CMP #ai_likes_end - ai_likes : BCS next
    TAX : LDA ai_likes,X : JSR buy
.next
    DEC tries : BNE try
    RTS
}
.ai_likes
    EQUB 1, 1, 2, 3, 4, 5, 6, 7, I_ROLLER, I_HEAVY_ROLLER, I_SANDHOG
    EQUB I_PARACHUTE, I_BATTERY, I_MAG, I_SHIELD + 1, I_FORCE
ASSERT P% - ai_likes <= 16
.ai_likes_end

\ ---------------------------------------------------------------------------
\ Scores.

\ Show the scores after round_no. A = the winner, or &FF for nobody.
.scores
{
    ZA_AUTO1 i, winner
    STA winner
    JSR cls
    PRINT_AT C_WHITE, 13, 3, "ROUND"            ; (the spaces: in the fields)
    LDA round_no : LDX #3 : JSR print_byte
    PRINT6 " OF"
    LDA num_rounds : LDX #3 : JSR print_byte
    LDA #12 : LDX #6 : JSR at
    LDX winner : BMI nobody
    JSR print_name
    PRINT6 " WINS"
    BEQ table                                   ; (print6 leaves Z set)
.nobody
    PRINT6 "NOBODY WINS"
.table
    PRINT_AT C_CYAN, 6, 10, "PLAYER       SCORE    MONEY"
    LDA #0 : STA i
.row
    LDA i : ASL A : ADC #12 : TAX : LDA #6 : JSR at
    LDX i : JSR print_name
    LDA #4*20 : STA text_x
    LDX i : LDA tank_score,X : LDX #3 : JSR print_byte
    LDA #4*26 : STA text_x
    LDX i : JSR print_money
    INC i : LDA i : CMP num_players : BNE row
    PRINT_AT C_WHITE, 11, 28, "SPACE TO GO ON"
    JMP wait_space
}

\ Everyone's money earns interest between rounds - m/16 - m/64, about 5%
\ - and everyone is paid $2000.
.interest
{
    ZA_AUTO1 i
    LDA #0 : STA i
.player
    \ add money / 16
    LDX i : JSR get_money
    LDY #4 : JSR shift
    LDX i : JSR money_add
    \ and take away money / 64 (unconditionally, unlike money_pay)
    LDY #2 : JSR shift
    LDX i : LDY times3,X
    LDA #&FF : SEC : JSR add_money
    \ and a wage, so whoever lost the round can still buy something
    LDA #4 : JSR five_hundreds
    LDX i : JSR money_add
    INC i : LDA i : CMP num_players : BNE player
    RTS
.shift
    LSR num+2 : ROR num+1 : ROR num
    DEY : BNE shift
    RTS
}

\ The game is over: whoever scored most is champion.
.champion
{
    ZA_AUTO1 best
    LDX #0 : STX best
.find
    LDA tank_score,X : LDY best : CMP tank_score,Y : BCC @+ : STX best : .@
    INX : CPX num_players : BNE find
    JSR draw_title
    LDA #9 : LDX #12 : JSR at
    LDX best : JSR print_name
    PRINT6 " IS CHAMPION"
    JSR snd_fanfare
    PRINT_AT C_WHITE, 10, 28, "SPACE TO PLAY AGAIN"
    \ (on into wait_space)
}
\ Wait for SPACE.
.wait_space
    JSR get_key : CMP #32 : BNE wait_space
    RTS
