\ ***************************************************************************
\ Napalm and Liquid Dirt: liquid poured where the shell lands.
\
\ The heightmap makes liquid cheap. Each unit starts at the impact column
\ and runs to whichever neighbour is lower - counting the liquid already
\ settled there - until neither is, then settles on top. Pools fill level
\ by themselves, a unit at a time. Fire is drawn in the glow colours, so
\ it flickers with no extra work, burns tanks by how much of it has pooled
\ under them, and drains away. Liquid dirt simply becomes ground.
\ ***************************************************************************

\ Liquid settled in each column. The disc tables are idle while liquid
\ runs, and profile, profile_prev and colspan sit together in memory.
liquid = profile
ASSERT fall_x - profile >= SCREEN_W

ZA_AUTO1 pour_fire          ; nonzero: napalm; zero: liquid dirt
ZA_AUTO1 pour_top, pour_lo, pour_hi     ; the area the liquid covered

\ Pour expl_r units at hit_x.
.pour
{
    ZA_AUTO1 n, x, lv, left, right, dir
    LDA expl_r : STA n
    LDX #SCREEN_W : LDA #0
.clear
    DEX : STA liquid,X : BNE clear
    STA pour_hi
    LDA #&FF : STA pour_top : STA pour_lo
.unit
    LDA shot_vx+2 : STA dir                     ; each unit starts the shell's way
    LDX hit_x
.flow
    \ The levels here and either side; a screen edge is a wall.
    STX x
    JSR level : STA lv
    LDA #0 : CPX #0 : BEQ @+ : DEX : JSR level : INX : .@
    STA left
    LDA #0 : CPX #SCREEN_W-1 : BEQ @+ : INX : JSR level : DEX : .@
    STA right
    \ Run towards the lower side (a bigger row number is lower); on a
    \ tie, keep the way it was going.
    CMP left : BCC lefter : BNE righter
    BIT dir : BMI lefter
.righter
    LDA right : CMP lv : BCC settle : BEQ flat
    LDA #0 : STA dir : INX : JMP flow
.lefter
    LDA left : CMP lv : BCC settle : BEQ flat
    LDA #&FF : STA dir : DEX : JMP flow
.flat
    \ Level ground: carry on the same way if it stays level, and stop
    \ where it rises. Without this, liquid piles into a cone; with it,
    \ pools fill level from their edges. (A unit only turns round after
    \ a step down, so it can't oscillate on a flat.)
    BIT dir : BMI flatleft
    LDA right : CMP lv : BNE settle
    INX : JMP flow
.flatleft
    LDA left : CMP lv : BNE settle
    DEX : JMP flow
.settle
    INC liquid,X
    LDY lv : DEY                                ; the new top row
    CPY #TOP : BCC next                         ; (off the top: not drawn)
    CPY pour_top : BCS @+ : STY pour_top : .@
    CPX pour_lo : BCS @+ : STX pour_lo : .@
    CPX pour_hi : BCC @+ : STX pour_hi : .@
    LDA dirtrow,Y
    BIT pour_fire : BPL @+
    TYA : AND #7 : ORA #C_HOT : TAX : LDA cbytes,X : LDX x
.@  JSR plot
.next
    \ Two units a frame: it pours rather than appears.
    LDA n : LSR A : BCC @+
    JSR wait_vsync : JSR glow
.@  DEC n : JNE unit
    RTS
}

\ The surface row of column X: ground less the liquid on it.
.level
    LDA ground,X : SEC : SBC liquid,X
    RTS

\ Napalm: pour, burn whoever it reaches, flicker a while, then go out.
.napalm
{
    ZA_AUTO1 shooter, sum, k
    LDA #&80 : STA pour_fire
    JSR snd_fire
    JSR pour
    \ Each tank burns in proportion to the fire under it.
    LDA cur : STA shooter
    LDX #0
.tank
    STX cur
    LDA tank_alive,X : BEQ next
    LDA #0 : STA sum
    LDA tank_x,X : SEC : SBC #TANK_HALF : TAY
    LDA #2*TANK_HALF+1 : STA k
.col
    LDA liquid,Y : CLC : ADC sum : STA sum
    INY : DEC k : BNE col
    LDA sum : BEQ next
    LDX blast_power : JSR umul8
    LDA umul8.hi : BEQ @+ : LDA #255 : STA umul8.lo : .@
    LDA umul8.lo : JSR hurt
.next
    LDX cur : INX : CPX num_players : BNE tank
    LDA shooter : STA cur
    \ Let it burn.
    LDA #40 : STA k
.burn
    JSR wait_vsync : JSR wait_vsync : JSR glow
    DEC k : BNE burn
    JSR glow_off
    \ Out: repaint what it covered, from the model (if any of it showed).
    LDA pour_hi : CMP pour_lo : BCC out
    LDA pour_lo : STA rect_x0
    LDA pour_hi : STA rect_x1
    LDA pour_top : STA bg_y0
    LDA #FLOOR : STA bg_y1
    JSR repaint
.out
    JMP draw_tanks
}

\ Liquid dirt: pour, and what settled is ground now.
.liquid_dirt
{
    LDA #0 : STA pour_fire
    JSR pour
    LDX #SCREEN_W
.col
    DEX
    LDA ground,X : SEC : SBC liquid,X : STA ground,X
    TXA : BNE col
    JMP draw_tanks
}
