\ ***************************************************************************
\ Memory outside the code: tables built at run time and per-player state.
\ Each area is a section with a guard, so baron lays it out and complains
\ if anything overflows - hand-placed addresses overlapped twice before
\ this file existed.
\ ***************************************************************************

\ The bottom of the stack page holds constant item tables (lowdata.6502).
\ The stack itself never gets near them: a whole game's deepest stack was
\ &01D1 (measured), so this guard leaves a 40-byte margin below it. Don't
\ push it further without measuring again.
stack_low_guard = &01A8

\ The top of zero page, carved off baron's allocator pool (ZA_POOL in
\ main.6502 stops below zp_fixed). The busiest per-player arrays live here
\ because every LDA/STA/INC tank_x,X is then a byte shorter: nine of them
\ saved 117 bytes. Only arrays read mostly with ,X pay: abs,Y has no zp
\ form (except LDX/STX), and every byte here is one the allocator loses.
\ When the allocator ran out (the third memory pass), tank_colour, with
\ the fewest accesses, went back out to the NMI area; tank_weapon is next.
\ zp,X wraps at &FF where abs,X would not; the indices are all < MAXP*3.
ZP_ARRAYS = 8
zp_fixed = &90 - ZP_ARRAYS * MAXP
SECTION ZeroPage, org = zp_fixed, guard = &90
.tank_weapon    SKIP MAXP       ; the weapon each player has selected
.tank_power_lo  SKIP MAXP       ; 0-1000
.tank_power_hi  SKIP MAXP
.tank_alive     SKIP MAXP
.tank_health    SKIP MAXP       ; 0-100; max power is 10x this
.tank_y         SKIP MAXP       ; bottom row
.tank_x         SKIP MAXP       ; centre column
.tank_angle     SKIP MAXP       ; 0 = right, 90 = up, 180 = left
ENDSECTION

\ The printer buffer: no printer here.
SECTION Printer, org = &0880, guard = &08C0
.tank_shield    SKIP MAXP       ; shield strength left, 0 = none
.tank_mag       SKIP MAXP       ; nonzero: the shield is a mag
.printer_end
ENDSECTION

\ BASIC's workspace: four page-sized tables, indexed by screen row.
SECTION Rows, org = &0400, guard = &0800
.rowlo          SKIP 256        ; screen address of (0, y)
.rowhi          SKIP 256
.skyrow         SKIP 256        ; sky colour byte for row y (both pixels)
.dirtrow        SKIP 256        ; dirt colour byte for row y
ENDSECTION

\ The tape and RS423 buffers, soft keys and user-defined characters.
SECTION Tables, org = &0900, guard = &0D00
.ground         SKIP SCREEN_W+1 ; first dirt row of column x
.profile        SKIP MAX_R+1    ; half-widths of the current disc, by |dy|
.profile_prev   SKIP MAX_R+1    ; the previous ring's, while a blast grows
.colspan        SKIP MAX_R/2+2  ; half-heights of the current disc, by |dx|
.fall_x         SKIP MAX_R+3    ; columns with a block of dirt falling,
.fall_top       SKIP MAX_R+3    ;   the block's top row,
.fall_bot       SKIP MAX_R+3    ;   bottom row,
.fall_dist      SKIP MAX_R+3    ;   and how far it has still to go
.tank_type      SKIP MAXP       ; HUMAN or a computer personality
.tank_plays     SKIP MAXP       ; the same, but an UNKNOWN's real one
.tank_tries     SKIP MAXP       ; shots a tosser has had
.tank_money     SKIP MAXP*3     ; 24-bit, low bytes first, by player
.tank_score     SKIP MAXP
.inv            SKIP MAXP * NITEMS  ; inv[inv_base[p] + item] (weapons.6502)
.tables_end
ENDSECTION

\ The NMI area; &0D00 itself stays the OS's RTI in case one ever comes.
SECTION Nmi, org = &0D01, guard = &0E00
.shells         SKIP MAXSH * 16 ; shells in flight (weapons.6502)
.sh_drawn       SKIP MAXSH      ; nonzero while the shell's dot is on screen
.sh_oldx        SKIP MAXSH
.tank_colour    SKIP MAXP       ; logical colour (out of zero page since
                                ; the allocator ran short)
.sh_active      SKIP MAXSH
.nmi_end
ENDSECTION

\ Five more holes are filled with constant tables, carried in the SCORCH
\ file and copied into place once at start-up (lowdata.6502, boot.6502):
\   &0100-stack_low_guard  the bottom of the stack page
\   printer_end-&08BF  the rest of the printer buffer: nothing is ever
\                  printed, and &08C0 up holds the four envelopes
\   &0380-&03DF  the cassette filing system's workspace; no tape is ever used
\   tables_end-&0CFF  the rest of the user-defined characters
\   nmi_end-&0DEF  the rest of the extended vectors, which only ROMs use;
\                  &0DF0-&0DFF is the ROMs' workspace table and stays put
